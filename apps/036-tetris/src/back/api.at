// Backend contract. A small object keeps the JSON shape explicit for Vue,
// HTTP VM, and merged Rust clients.
use db

// Kept as the public contract anchor for future typed score history. The
// current endpoint returns the scalar best score so every AutoUI renderer can
// consume it without a dynamic JSON collection.
pub type Score = {
    id: int
    score: int
}

#[api(method = "GET", path = "/api/tetris/record")]
pub fn list_scores() int { return db.read_best() }

#[api(method = "POST", path = "/api/tetris/score")]
pub fn create_score(score str) bool { return db.create_score(score) }
