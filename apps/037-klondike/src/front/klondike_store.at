store KlondikeStore {
    model {
        var skin_mode str = "vector"
        var skin_label str = "自绘矢量排版 (Vector)"
        var selected_card_id int = 6
        var stock_count int = 24

        // 按钮样式
        var btn_vector_class str = "px-3 py-1.5 rounded-lg text-xs font-semibold bg-indigo-600 text-white shadow-sm"
        var btn_svg_class str = "px-3 py-1.5 rounded-lg text-xs font-semibold border border-slate-300 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800"

        // 典型牌面展台列表
        var showcase_cards = []
        // 4 个基础堆槽位
        var foundation_slots = []
        // 弃牌堆顶牌
        var waste_card = {
            id: 24,
            rank: 12,
            rank_text: "Q",
            suit: "heart",
            color_class: "text-red-600",
            court_badge: "sparkles",
            is_face_down: false,
            card_class: "w-[76px] h-[106px] rounded-lg bg-white border border-slate-200 text-slate-900 p-1.5 justify-between shadow-md relative select-none",
            svg_src: "/assets/cards/classic/Q_heart.svg"
        }
        // 牌桌 3 列模拟
        var tab_col0 = []
        var tab_col1 = []
        var tab_col2 = []
    }

    msg {
        Init,
        SetSkinMode(str),
        SelectCard(int),
        DrawStock,
        ResetDeck,
        RebuildCards
    }

    on {
        .Init -> {
            .skin_mode = "vector"
            .selected_card_id = 6
            .stock_count = 24
            .RebuildCards()
        }

        .SetSkinMode(mode) -> {
            .skin_mode = mode
            if mode == "vector" {
                .skin_label = "自绘矢量排版 (Vector)"
                .btn_vector_class = "px-3 py-1.5 rounded-lg text-xs font-semibold bg-indigo-600 text-white shadow-sm"
                .btn_svg_class = "px-3 py-1.5 rounded-lg text-xs font-semibold border border-slate-300 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800"
            } else {
                .skin_label = "外部 SVG 素材包 (SVG Skin)"
                .btn_vector_class = "px-3 py-1.5 rounded-lg text-xs font-semibold border border-slate-300 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800"
                .btn_svg_class = "px-3 py-1.5 rounded-lg text-xs font-semibold bg-indigo-600 text-white shadow-sm"
            }
            .RebuildCards()
        }

        .SelectCard(id) -> {
            if .selected_card_id == id {
                .selected_card_id = -1
            } else {
                .selected_card_id = id
            }
            .RebuildCards()
        }

        .DrawStock -> {
            if .stock_count > 0 {
                .stock_count = .stock_count - 1
            } else {
                .stock_count = 24
            }
        }

        .ResetDeck -> {
            .selected_card_id = -1
            .stock_count = 24
            .RebuildCards()
        }

        .RebuildCards -> {
            // 构造精选展示牌
            .showcase_cards = [
                // 0: 黑桃 A
                {
                    id: 0,
                    rank: 1,
                    rank_text: "A",
                    suit: "spade",
                    color_class: "text-slate-900",
                    is_court: false,
                    court_badge: "",
                    is_face_down: false,
                    is_selected: (.selected_card_id == 0),
                    card_class: if .selected_card_id == 0 { "w-[76px] h-[106px] rounded-lg bg-white border-2 border-indigo-600 text-slate-900 p-1.5 justify-between shadow-xl relative cursor-pointer select-none ring-4 ring-indigo-400/40 -translate-y-2" } else { "w-[76px] h-[106px] rounded-lg bg-white border border-slate-200 text-slate-900 p-1.5 justify-between shadow-md relative cursor-pointer select-none hover:border-slate-300" },
                    svg_src: "/assets/cards/classic/A_spade.svg"
                },
                // 1: 红桃 K (带王冠徽章)
                {
                    id: 25,
                    rank: 13,
                    rank_text: "K",
                    suit: "heart",
                    color_class: "text-red-600",
                    is_court: true,
                    court_badge: "crown",
                    is_face_down: false,
                    is_selected: (.selected_card_id == 25),
                    card_class: if .selected_card_id == 25 { "w-[76px] h-[106px] rounded-lg bg-white border-2 border-indigo-600 text-slate-900 p-1.5 justify-between shadow-xl relative cursor-pointer select-none ring-4 ring-indigo-400/40 -translate-y-2" } else { "w-[76px] h-[106px] rounded-lg bg-white border border-slate-200 text-slate-900 p-1.5 justify-between shadow-md relative cursor-pointer select-none hover:border-slate-300" },
                    svg_src: "/assets/cards/classic/K_heart.svg"
                },
                // 2: 方块 Q (带闪耀徽章)
                {
                    id: 37,
                    rank: 12,
                    rank_text: "Q",
                    suit: "diamond",
                    color_class: "text-red-600",
                    is_court: true,
                    court_badge: "sparkles",
                    is_face_down: false,
                    is_selected: (.selected_card_id == 37),
                    card_class: if .selected_card_id == 37 { "w-[76px] h-[106px] rounded-lg bg-white border-2 border-indigo-600 text-slate-900 p-1.5 justify-between shadow-xl relative cursor-pointer select-none ring-4 ring-indigo-400/40 -translate-y-2" } else { "w-[76px] h-[106px] rounded-lg bg-white border border-slate-200 text-slate-900 p-1.5 justify-between shadow-md relative cursor-pointer select-none hover:border-slate-300" },
                    svg_src: "/assets/cards/classic/Q_diamond.svg"
                },
                // 3: 梅花 J (带盾牌徽章)
                {
                    id: 49,
                    rank: 11,
                    rank_text: "J",
                    suit: "club",
                    color_class: "text-slate-900",
                    is_court: true,
                    court_badge: "shield",
                    is_face_down: false,
                    is_selected: (.selected_card_id == 49),
                    card_class: if .selected_card_id == 49 { "w-[76px] h-[106px] rounded-lg bg-white border-2 border-indigo-600 text-slate-900 p-1.5 justify-between shadow-xl relative cursor-pointer select-none ring-4 ring-indigo-400/40 -translate-y-2" } else { "w-[76px] h-[106px] rounded-lg bg-white border border-slate-200 text-slate-900 p-1.5 justify-between shadow-md relative cursor-pointer select-none hover:border-slate-300" },
                    svg_src: "/assets/cards/classic/J_club.svg"
                },
                // 4: 红桃 10 (数字牌)
                {
                    id: 22,
                    rank: 10,
                    rank_text: "10",
                    suit: "heart",
                    color_class: "text-red-600",
                    is_court: false,
                    court_badge: "",
                    is_face_down: false,
                    is_selected: (.selected_card_id == 22),
                    card_class: if .selected_card_id == 22 { "w-[76px] h-[106px] rounded-lg bg-white border-2 border-indigo-600 text-slate-900 p-1.5 justify-between shadow-xl relative cursor-pointer select-none ring-4 ring-indigo-400/40 -translate-y-2" } else { "w-[76px] h-[106px] rounded-lg bg-white border border-slate-200 text-slate-900 p-1.5 justify-between shadow-md relative cursor-pointer select-none hover:border-slate-300" },
                    svg_src: "/assets/cards/classic/10_heart.svg"
                },
                // 5: 黑桃 7 (默认选中演示)
                {
                    id: 6,
                    rank: 7,
                    rank_text: "7",
                    suit: "spade",
                    color_class: "text-slate-900",
                    is_court: false,
                    court_badge: "",
                    is_face_down: false,
                    is_selected: (.selected_card_id == 6),
                    card_class: if .selected_card_id == 6 { "w-[76px] h-[106px] rounded-lg bg-white border-2 border-indigo-600 text-slate-900 p-1.5 justify-between shadow-xl relative cursor-pointer select-none ring-4 ring-indigo-400/40 -translate-y-2" } else { "w-[76px] h-[106px] rounded-lg bg-white border border-slate-200 text-slate-900 p-1.5 justify-between shadow-md relative cursor-pointer select-none hover:border-slate-300" },
                    svg_src: "/assets/cards/classic/7_spade.svg"
                },
                // 6: 方块 2
                {
                    id: 27,
                    rank: 2,
                    rank_text: "2",
                    suit: "diamond",
                    color_class: "text-red-600",
                    is_court: false,
                    court_badge: "",
                    is_face_down: false,
                    is_selected: (.selected_card_id == 27),
                    card_class: if .selected_card_id == 27 { "w-[76px] h-[106px] rounded-lg bg-white border-2 border-indigo-600 text-slate-900 p-1.5 justify-between shadow-xl relative cursor-pointer select-none ring-4 ring-indigo-400/40 -translate-y-2" } else { "w-[76px] h-[106px] rounded-lg bg-white border border-slate-200 text-slate-900 p-1.5 justify-between shadow-md relative cursor-pointer select-none hover:border-slate-300" },
                    svg_src: "/assets/cards/classic/2_diamond.svg"
                },
                // 7: 盖牌 (Card Back)
                {
                    id: 99,
                    rank: 0,
                    rank_text: "",
                    suit: "",
                    color_class: "",
                    is_court: false,
                    court_badge: "",
                    is_face_down: true,
                    is_selected: false,
                    card_class: "w-[76px] h-[106px] rounded-lg bg-gradient-to-br from-indigo-700 via-indigo-800 to-indigo-950 border-2 border-indigo-300/40 shadow-md items-center justify-center relative cursor-pointer select-none",
                    svg_src: "/assets/cards/classic/card_back.svg"
                }
            ]

            // 基础堆槽位
            .foundation_slots = [
                {
                    suit_name: "黑桃",
                    suit: "spade",
                    has_card: true,
                    rank_text: "A",
                    color_class: "text-slate-900",
                    slot_class: "w-[76px] h-[106px] rounded-lg bg-white border border-slate-200 text-slate-900 p-1.5 justify-between relative shadow-md select-none"
                },
                {
                    suit_name: "红桃",
                    suit: "heart",
                    has_card: true,
                    rank_text: "3",
                    color_class: "text-red-600",
                    slot_class: "w-[76px] h-[106px] rounded-lg bg-white border border-slate-200 text-slate-900 p-1.5 justify-between relative shadow-md select-none"
                },
                {
                    suit_name: "方块",
                    suit: "diamond",
                    has_card: false,
                    rank_text: "",
                    color_class: "",
                    slot_class: "w-[76px] h-[106px] rounded-lg border-2 border-dashed border-emerald-500/40 bg-emerald-950/20 items-center justify-center relative p-1.5"
                },
                {
                    suit_name: "梅花",
                    suit: "club",
                    has_card: false,
                    rank_text: "",
                    color_class: "",
                    slot_class: "w-[76px] h-[106px] rounded-lg border-2 border-dashed border-emerald-500/40 bg-emerald-950/20 items-center justify-center relative p-1.5"
                }
            ]

            // 牌桌列 0
            .tab_col0 = [
                {
                    id: 8,
                    rank: 9,
                    rank_text: "9",
                    suit: "spade",
                    color_class: "text-slate-900",
                    is_court: false,
                    court_badge: "",
                    is_face_down: false,
                    wrapper_class: "",
                    card_class: if .selected_card_id == 8 { "w-[76px] h-[106px] rounded-lg bg-white border-2 border-indigo-600 text-slate-900 p-1.5 justify-between shadow-xl relative cursor-pointer select-none ring-4 ring-indigo-400/40 -translate-y-2" } else { "w-[76px] h-[106px] rounded-lg bg-white border border-slate-200 text-slate-900 p-1.5 justify-between shadow-md relative cursor-pointer select-none hover:border-slate-300" }
                }
            ]

            // 牌桌列 1 (1 盖牌 + 1 明牌，带负外边距叠牌)
            .tab_col1 = [
                {
                    id: 101,
                    rank: 0,
                    rank_text: "",
                    suit: "",
                    color_class: "",
                    is_court: false,
                    court_badge: "",
                    is_face_down: true,
                    wrapper_class: "",
                    card_class: "w-[76px] h-[106px] rounded-lg bg-gradient-to-br from-indigo-700 via-indigo-800 to-indigo-950 border-2 border-indigo-300/40 shadow-md items-center justify-center relative cursor-pointer select-none"
                },
                {
                    id: 20,
                    rank: 8,
                    rank_text: "8",
                    suit: "heart",
                    color_class: "text-red-600",
                    is_court: false,
                    court_badge: "",
                    is_face_down: false,
                    wrapper_class: "-mt-18",
                    card_class: if .selected_card_id == 20 { "w-[76px] h-[106px] rounded-lg bg-white border-2 border-indigo-600 text-slate-900 p-1.5 justify-between shadow-xl relative cursor-pointer select-none ring-4 ring-indigo-400/40 -translate-y-2" } else { "w-[76px] h-[106px] rounded-lg bg-white border border-slate-200 text-slate-900 p-1.5 justify-between shadow-md relative cursor-pointer select-none hover:border-slate-300" }
                }
            ]

            // 牌桌列 2 (2 盖牌 + 2 明牌连贯段)
            .tab_col2 = [
                {
                    id: 102,
                    rank: 0,
                    rank_text: "",
                    suit: "",
                    color_class: "",
                    is_court: false,
                    court_badge: "",
                    is_face_down: true,
                    wrapper_class: "",
                    card_class: "w-[76px] h-[106px] rounded-lg bg-gradient-to-br from-indigo-700 via-indigo-800 to-indigo-950 border-2 border-indigo-300/40 shadow-md items-center justify-center relative cursor-pointer select-none"
                },
                {
                    id: 103,
                    rank: 0,
                    rank_text: "",
                    suit: "",
                    color_class: "",
                    is_court: false,
                    court_badge: "",
                    is_face_down: true,
                    wrapper_class: "-mt-18",
                    card_class: "w-[76px] h-[106px] rounded-lg bg-gradient-to-br from-indigo-700 via-indigo-800 to-indigo-950 border-2 border-indigo-300/40 shadow-md items-center justify-center relative cursor-pointer select-none"
                },
                {
                    id: 12,
                    rank: 13,
                    rank_text: "K",
                    suit: "spade",
                    color_class: "text-slate-900",
                    is_court: true,
                    court_badge: "crown",
                    is_face_down: false,
                    wrapper_class: "-mt-18",
                    card_class: if .selected_card_id == 12 { "w-[76px] h-[106px] rounded-lg bg-white border-2 border-indigo-600 text-slate-900 p-1.5 justify-between shadow-xl relative cursor-pointer select-none ring-4 ring-indigo-400/40 -translate-y-2" } else { "w-[76px] h-[106px] rounded-lg bg-white border border-slate-200 text-slate-900 p-1.5 justify-between shadow-md relative cursor-pointer select-none hover:border-slate-300" }
                },
                {
                    id: 24,
                    rank: 12,
                    rank_text: "Q",
                    suit: "heart",
                    color_class: "text-red-600",
                    is_court: true,
                    court_badge: "sparkles",
                    is_face_down: false,
                    wrapper_class: "-mt-18",
                    card_class: if .selected_card_id == 24 { "w-[76px] h-[106px] rounded-lg bg-white border-2 border-indigo-600 text-slate-900 p-1.5 justify-between shadow-xl relative cursor-pointer select-none ring-4 ring-indigo-400/40 -translate-y-2" } else { "w-[76px] h-[106px] rounded-lg bg-white border border-slate-200 text-slate-900 p-1.5 justify-between shadow-md relative cursor-pointer select-none hover:border-slate-300" }
                }
            ]
        }
    }
}
