widget CourtBadge (badge: str = "", style: str = "") {
    view {
        col {
            class: .style
            if .badge == "crown" {
                icon (name: "crown", class: .style) {}
            } else {
                if .badge == "sparkles" {
                    icon (name: "sparkles", class: .style) {}
                } else {
                    if .badge == "shield" {
                        icon (name: "shield", class: .style) {}
                    }
                }
            }
        }
    }
}
