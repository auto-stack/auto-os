use card_suit: CardSuit
use court_badge: CourtBadge

widget CardFace (rank: int = 0, rank_text: str = "", suit: str = "", color_class: str = "", is_court: bool = false, court_badge: str = "", is_face_down: bool = false, skin_mode: str = "vector", svg_src: str = "", is_selected: bool = false) {
    view {
        col {
            style: "w-full h-full relative pointer-events-none"

            if .skin_mode == "vector" {
                // 牌背：未选中
                if .is_face_down && !.is_selected {
                    col {
                        style: "w-[76px] h-[106px] rounded-lg bg-gradient-to-br from-indigo-700 via-indigo-800 to-indigo-950 border-2 border-indigo-300/50 items-center justify-center overflow-hidden shrink-0"
                        col {
                            style: "w-[64px] h-[92px] rounded border border-indigo-300/30 bg-indigo-800/50"
                        }
                    }
                }
                // 牌背：选中——indigo 描边 + ring（画在牌框内，避免被 wrapper overflow-hidden 裁掉）
                if .is_face_down && .is_selected {
                    col {
                        style: "w-[76px] h-[106px] rounded-lg bg-gradient-to-br from-indigo-700 via-indigo-800 to-indigo-950 border-2 border-indigo-400 ring-4 ring-indigo-400/60 items-center justify-center overflow-visible shrink-0 shadow-2xl"
                        col {
                            style: "w-[64px] h-[92px] rounded border border-indigo-200/40 bg-indigo-800/50"
                        }
                    }
                }

                // 牌面：未选中
                if !.is_face_down && !.is_selected {
                    col {
                        style: "w-[76px] h-[106px] rounded-lg bg-white border border-slate-200 text-slate-900 justify-between p-1.5 relative overflow-hidden shrink-0 shadow-md"
                        row {
                            style: "items-center gap-1 leading-none self-start"
                            text .rank_text {
                                style: "text-sm font-black font-bold " + .color_class
                            }
                            CardSuit (suit: .suit, style: "w-3.5 h-3.5 " + .color_class) {}
                        }
                        col {
                            style: "w-full flex-1 items-center justify-center pointer-events-none my-0.5"
                            if .rank == 1 {
                                CardSuit (suit: .suit, style: "w-8 h-8 opacity-85 " + .color_class) {}
                            }
                            if .is_court {
                                col {
                                    style: "items-center gap-0.5"
                                    text .rank_text {
                                        style: "text-2xl font-black font-bold leading-none " + .color_class
                                    }
                                    CourtBadge (badge: .court_badge, style: "w-4 h-4 opacity-70 " + .color_class) {}
                                }
                            }
                            if !.is_court && .rank > 1 {
                                CardSuit (suit: .suit, style: "w-6 h-6 opacity-30 " + .color_class) {}
                            }
                        }
                        row {
                            style: "items-center justify-end gap-0.5 self-end leading-none"
                            CardSuit (suit: .suit, style: "w-2.5 h-2.5 opacity-50 " + .color_class) {}
                            text .rank_text {
                                style: "text-[11px] font-black font-bold opacity-55 " + .color_class
                            }
                        }
                    }
                }
                // 牌面：选中——粗 indigo 边框 + ring
                if !.is_face_down && .is_selected {
                    col {
                        style: "w-[76px] h-[106px] rounded-lg bg-white border-2 border-indigo-600 ring-4 ring-indigo-400/60 text-slate-900 justify-between p-1.5 relative overflow-visible shrink-0 shadow-2xl"
                        row {
                            style: "items-center gap-1 leading-none self-start"
                            text .rank_text {
                                style: "text-sm font-black font-bold " + .color_class
                            }
                            CardSuit (suit: .suit, style: "w-3.5 h-3.5 " + .color_class) {}
                        }
                        col {
                            style: "w-full flex-1 items-center justify-center pointer-events-none my-0.5"
                            if .rank == 1 {
                                CardSuit (suit: .suit, style: "w-8 h-8 opacity-85 " + .color_class) {}
                            }
                            if .is_court {
                                col {
                                    style: "items-center gap-0.5"
                                    text .rank_text {
                                        style: "text-2xl font-black font-bold leading-none " + .color_class
                                    }
                                    CourtBadge (badge: .court_badge, style: "w-4 h-4 opacity-70 " + .color_class) {}
                                }
                            }
                            if !.is_court && .rank > 1 {
                                CardSuit (suit: .suit, style: "w-6 h-6 opacity-30 " + .color_class) {}
                            }
                        }
                        row {
                            style: "items-center justify-end gap-0.5 self-end leading-none"
                            CardSuit (suit: .suit, style: "w-2.5 h-2.5 opacity-50 " + .color_class) {}
                            text .rank_text {
                                style: "text-[11px] font-black font-bold opacity-55 " + .color_class
                            }
                        }
                    }
                }
            }

            if .skin_mode == "svg" {
                col {
                    style: "w-[76px] h-[106px] items-center justify-center p-1.5 bg-slate-50 dark:bg-slate-800 rounded-lg pointer-events-none overflow-hidden shrink-0 border border-slate-200 dark:border-slate-700"
                    icon (name: "image", class: "w-5 h-5 text-indigo-400 opacity-60") {}
                    text .svg_src { style: "text-[9px] text-center text-slate-500 truncate w-full mt-1" }
                    text "[SVG 皮肤包槽位]" { style: "text-[8px] text-indigo-500 font-mono" }
                }
            }
        }
    }
}
