widget CardFace (rank: int = 0, rank_text: str = "", suit: str = "", color_class: str = "", is_court: bool = false, court_badge: str = "", is_face_down: bool = false, skin_mode: str = "vector", svg_src: str = "") {
    view {
        col {
            style: "w-full h-full justify-between relative pointer-events-none"

            if .skin_mode == "vector" {
                if .is_face_down {
                    col {
                        style: "w-[64px] h-[92px] rounded border border-indigo-300/30 items-center justify-center bg-indigo-800/50 self-center my-auto"
                        icon (name: "layers", class: "w-6 h-6 text-indigo-200/60") {}
                    }
                }
                if !.is_face_down {
                    // 1. 左上角标：点数 + 迷你花色
                    col {
                        style: "items-center w-4 gap-0.5 leading-none"
                        text .rank_text {
                            class: "text-xs font-bold font-mono " + .color_class
                        }
                        CardSuit (suit: .suit, style: "w-3 h-3 " + .color_class) {}
                    }

                    // 2. 牌面中心区域
                    col {
                        style: "absolute inset-0 items-center justify-center pointer-events-none"
                        if .rank == 1 {
                            CardSuit (suit: .suit, style: "w-8 h-8 opacity-85 " + .color_class) {}
                        }
                        if .is_court {
                            col {
                                style: "items-center gap-0.5"
                                text .rank_text {
                                    class: "text-xl font-bold font-serif opacity-75 leading-none " + .color_class
                                }
                                CourtBadge (badge: .court_badge, style: "w-3.5 h-3.5 opacity-70 " + .color_class) {}
                            }
                        }
                        if !.is_court && .rank > 1 {
                            CardSuit (suit: .suit, style: "w-6 h-6 opacity-30 " + .color_class) {}
                        }
                    }

                    // 3. 右下角标 (微型角标)
                    row {
                        style: "items-center justify-end gap-0.5 self-end"
                        CardSuit (suit: .suit, style: "w-2.5 h-2.5 opacity-50 " + .color_class) {}
                        text .rank_text {
                            class: "text-[10px] font-bold font-mono opacity-50 " + .color_class
                        }
                    }
                }
            }

            if .skin_mode == "svg" {
                col {
                    style: "w-full h-full items-center justify-center p-1 bg-slate-50 dark:bg-slate-800 rounded pointer-events-none"
                    icon (name: "image", class: "w-5 h-5 text-indigo-400 opacity-60") {}
                    text .svg_src { style: "text-[9px] text-center text-slate-500 truncate w-full mt-1" }
                    text "[SVG 皮肤包槽位]" { style: "text-[8px] text-indigo-500 font-mono" }
                }
            }
        }
    }
}
