ame\"\n            .hCol2 = \"Contact Name\"\n            .hCol3 = \"City\"\n            .hCol4 = \"Country\"\n            .hCol5 = \"Phone\"\n\n            .schemaColumns = [\n                { cid: 0, name: \"id\", type: \"INTEGER\", notnull: \"YES\", dflt: \"NULL\", pk: \"PK\" },\n                { cid: 1, name: \"company_name\", type: \"TEXT\", notnull: \"YES\", dflt: \"NULL\", pk: \"-\" },\n                { cid: 2, name: \"contact_name\", type: \"TEXT\", notnull: \"NO\", dflt: \"NULL\", pk: \"-\" },\n                { cid: 3, name: \"city\", type: \"TEXT\", notnull: \"NO\", dflt: \"NULL\", pk: \"-\" },\n                { cid: 4, name: \"country\", type: \"TEXT\", notnull: \"NO\", dflt: \"NULL\", pk: \"-\" },\n                { cid: 5, name: \"phone\", type: \"TEXT\", notnull: \"NO\", dflt: \"NULL\", pk: \"-\" }\n            ]\n            .schemaIndexes = [\n                { name: \"pk_customers\", cols: \"id\", unique: \"UNIQUE (PRIMARY KEY)\" },\n                { name: \"idx_customers_country\", cols: \"country\", unique: \"INDEX\" }\n            ]\n            .schemaDdl = \"CREATE TABLE customers (\\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\\n  company_name TEXT NOT NULL,\\n  contact_name TEXT,\\n  city TEXT,\\n  country TEXT,\\n  phone TEXT\\n);\"\n            .tableStatsText = \"Table: customers · 6 Columns · 15 Records in RAM (91 in DB) · ~14 KB\"\n\n            // 载入初始数据行切片\n            var sl = []\n            var i = 0\n            for r in .customers {\n                if i < .pageSize {\n                    sl.push(r)\n                }\n                i = i + 1\n            }\n            .activeRows = sl\n            .totalRows = .customers.len()\n            .filteredCount = .customers.len()\n            .totalPages = 2\n            .showingText = f\"Showing 1 - ${sl.len()} of ${.totalRows} rows\"\n        }\n\n        .SelectTab(tab) -> {\n            .activeTab = tab\n        }\n\n        .SelectTable(tbl) -> {\n            .activeTable = tb