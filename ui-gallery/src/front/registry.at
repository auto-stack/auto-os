d = \"ID ↑\"\n                .hCol1 = \"First Name\"\n                .hCol2 = \"Last Name\"\n                .hCol3 = \"Title\"\n                .hCol4 = \"Department\"\n                .hCol5 = \"Extension\"\n                .totalRows = .employees.len()\n                .filteredCount = .employees.len()\n                .schemaColumns = [\n                    { cid: 0, name: \"id\", type: \"INTEGER\", notnull: \"YES\", dflt: \"NULL\", pk: \"PK\" },\n                    { cid: 1, name: \"first_name\", type: \"TEXT\", notnull: \"YES\", dflt: \"NULL\", pk: \"-\" },\n                    { cid: 2, name: \"last_name\", type: \"TEXT\", notnull: \"YES\", dflt: \"NULL\", pk: \"-\" },\n                    { cid: 3, name: \"title\", type: \"TEXT\", notnull: \"NO\", dflt: \"NULL\", pk: \"-\" },\n                    { cid: 4, name: \"department\", type: \"TEXT\", notnull: \"NO\", dflt: \"NULL\", pk: \"-\" }\n                ]\n                .schemaIndexes = [\n                    { name: \"pk_employees\", cols: \"id\", unique: \"UNIQUE (PRIMARY KEY)\" }\n                ]\n                .schemaDdl = \"CREATE TABLE employees (\\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\\n  first_name TEXT NOT NULL,\\n  last_name TEXT NOT NULL,\\n  title TEXT,\\n  department TEXT\\n);\"\n                .tableStatsText = \"Table: employees · 5 Columns · 6 Records in RAM · ~8 KB\"\n                var sl = []\n                for r in .employees { sl.push(r) }\n                .activeRows = sl\n                .totalPages = 1\n                .showingText = f\"Showing 1 - ${sl.len()} of ${.totalRows} rows\"\n            }\n\n            if tbl == \"audit_logs\" {\n                .hId = \"Log ID ↑\"\n                .hCol1 = \"Timestamp\"\n                .hCol2 = \"Action\"\n                .hCol3 = \"User\"\n                .hCol4 = \"Client IP\"\n                .hCol5 = \"Result Code\"\n                .totalRows = .audit_logs.len()\n                .filteredCount = .audit_logs.len()\n  