0,300' fill='rgb(120,53,15)'/><polygon points='60,130 160,150 140,170 40,150' fill='rgb(239,68,68)'/><polygon points='40,150 140,170 120,190 20,170' fill='rgb(255,255,255)'/><rect x='80' y='180' width='50' height='60' fill='rgb(253,224,71)' opacity='0.85'/></svg>\",\n            \"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 300'><defs><linearGradient id='g23' x1='0' y1='0' x2='0' y2='1'><stop offset='0%' stop-color='rgb(2,132,199)'/><stop offset='100%' stop-color='rgb(125,211,252)'/></linearGradient></defs><rect width='400' height='300' fill='url(%23g23)'/><path d='M40,90 Q120,60 220,100 Q300,70 360,90' stroke='rgb(255,255,255)' stroke-width='16' stroke-linecap='round' fill='none' opacity='0.7'/><path d='M80,160 Q180,130 280,170 Q340,140 380,160' stroke='rgb(255,255,255)' stroke-width='12' stroke-linecap='round' fill='none' opacity='0.6'/><path d='M20,220 Q110,200 200,230 Q280,210 340,220' stroke='rgb(255,255,255)' stroke-width='10' stroke-linecap='round' fill='none' opacity='0.5'/></svg>\",\n            \"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 300'><rect width='400' height='300' fill='rgb(10,15,30)'/><line x1='70' y1='90' x2='160' y2='170' stroke='rgb(56,189,248)' stroke-width='2' opacity='0.6'/><line x1='160' y1='170' x2='260' y2='110' stroke='rgb(56,189,248)' stroke-width='2' opacity='0.6'/><line x1='260' y1='110' x2='330' y2='200' stroke='rgb(234,179,8)' stroke-width='2' opacity='0.6'/><line x1='160' y1='170' x2='210' y2='240' stroke='rgb(168,85,247)' stroke-width='2' opacity='0.6'/><circle cx='70' cy='90' r='6' fill='rgb(56,189,248)'/><circle cx='160' cy='170' r='8' fill='rgb(147,197,253)'/><circle cx='260' cy='110' r='7' fill='rgb(250,204,21)'/><circle cx='330' cy='200' r='6' fill='rgb(251,146,60)'/><circle cx='210' cy='240' r='5' fill='rgb(192,132,252)'/></svg>\"\n        ]\n\n        // ---- 主列表与视图列表（handler 构建；预置一项使 TS 推导字段类型，\n        //      027 files_view 同款）----\n        var photos = [\n            {\n                id: 1,\n                title: \"晨雾山谷\",\n                album: \"nature\",\n                seed: \"gal-01\",\n                date: \"2026-07-14\",\n                fav: false,\n                thumb: \"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 300'><defs><linearGradient id='g1' x1='0' y1='0' x2='0' y2='1'><stop offset='0%' stop-color='rgb(15,23,42)'/><stop offset='60%' stop-color='rgb(30,58,74)'/><stop offset='100%' stop-color='rgb(51,92,86)'/></linearGradient></defs><rect width='400' height='300' fill='url(%23g1)'/><circle cx='200' cy='120' r='45' fill='rgb(254,240,138)' opacity='0.85'/><polygon points='0,300 130,130 260,300' fill='rgb(20,83,45)' opacity='0.9'/><polygon points='140,300 280,110 400,300' fill='rgb(13,148,136)' opacity='0.85'/><polygon points='70,300 210,160 350,300' fill='rgb(34,197,94)' opacity='0.75'/><rect y='220' width='400' height='80' fill='rgb(255,255,255)' opacity='0.18'/></svg>\",\n                full: \"https://picsum.photos/seed/gal-01/1600/1200\"\n            }\n        ]\n        var view_list = [\n            {\n                id: 1,\n                title: \"晨雾山谷\",\n                album: \"nature\",\n                seed: \"gal-01\",\n                date: \"2026-07-14\",\n                fav: false,\n                thumb: \"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 300'><defs><linearGradient id='g1' x1='0' y1='0' x2='0' y2='1'><stop offset='0%' stop-color='rgb(15,23,42)'/><stop offset='60%' stop-color='rgb(30,58,74)'/><stop offset='100%' stop-color='rgb(51,92,86)'/></linearGradient></defs><rect width='400' height='300' fill='url(%23g1)'/><circle cx='200' cy='120' r='45' fill='rgb(254,240,138)' opacity='0.85'/><polygon points='0,300 130,130 260,300' fill='rgb(20,83,45)' opacity='0.9'/><polygon points='140,300 280,110 400,300' fill='rgb(13,148,136)' opacity='0.85'/><polygon points='70,300 210,160 350,300' fill='rgb(34,197,94)' opacity='0.75'/><rect y='220' width='400' height='80' fill='rgb(255,255,255)' opacity='0.18'/></svg>\",\n                full: \"https://picsum.photos/seed/gal-01/1600/1200\"\n            }\n        ]\n        // 与 view_list 平行的 id 列表（OpenPhoto 定位 + 循环导航；\n        // 字符串/标量列表下标读保真——028 注入形态约束同思路）\n        var view_ids = [1]\n\n        // 空态门控（027 has_items 同款；模板不可调 .len()）\n        var has_view bool = true\n\n        // accent 五色点（name = 主题契约 accent_color 值；dot = 色点类）\n        var accents = [\n            { name: \"coral\", dot: \"text-[#fb7185]\" },\n            { name: \"ocean\", dot: \"text-[#38bdf8]\" },\n            { name: \"sage\", dot: \"text-[#4ade80]\" },\n            { name: \"amber\", dot: \"text-[#fbbf24]\" },\n            { name: \"indigo\", dot: \"text-[#818cf8]\" }\n        ]\n\n        // ---- 计数与文案（handler 预拼，模板零方法调用）----\n        var view_label str = \"\"\n        var cnt_all str = \"0\"\n        var cnt_favorites str = \"0\"\n        var cnt_nature str = \"0\"\n        var cnt_city str = \"0\"\n        var cnt_sky str = \"0\"\n        var cnt_abstract str = \"0\"\n\n        // ---- 查看器（元信息 handler 预取，模板不做字段链查找）----\n        var cur_id int = -1\n        var cur_title str = \"\"\n        var cur_meta str = \"\"\n        var cur_full str = \"\"\n        var prev_id int = -1\n        var next_id int = -1\n        var fav_label str = \"♡ 收藏\"\n    }\n\n    view {\n        col {\n            style: \"w-full h-screen flex bg-background text-foreground overflow-hidden font-sans\"\n\n            // ══════════ 网格分支（T3）══════════\n            if .mode == \"grid\" {\n                row {\n                    style: \"w-full h-full flex flex-1 overflow-hidden\"\n\n                    // ---- 左侧边栏：标题 + 相册导航（手写展开，保静态图标名）----\n                    col {\n                        style: \"w-56 shrink-0 border-r border-border bg-card/40 flex flex-col py-3\"\n                        col {\n                            style: \"px-4 pt-1 pb-3 gap-0.5\"\n                            text \"图库 🖼\" { style: \"text-base font-bold\" }\n                            text \"Photos\" { style: \"text-[11px] text-muted-foreground uppercase tracking-wider\" }\n                        }\n                        col {\n                            style: \"mt-1 px-2 gap-0.5\"\n\n                            // 相册图标用 emoji 文本（027 先例）：heart/mountain/\n                            // building-2/cloud-sun/sparkles 不在 VM lucide 表\n                            // （renderer.rs lucide_svg 84 项闭集），跨端不一致；\n                            // icon (name:) 仅用于双端表内名字（sun/moon/chevron-*）。\n                            button {\n                                onclick: .SelectAlbum(\"all\")\n                                style: if .album == \"all\" { \"w-full flex items-center gap-2.5 h-9 px-3 rounded-lg bg-accent/10 text-accent border-l-2 border-primary\" } else { \"w-full flex items-center gap-2.5 h-9 px-3 rounded-lg bg-transparent text-muted-foreground hover:bg-accent/40 border-l-2 border-transparent\" }\n                                text \"🖼️\" { style: \"text-sm shrink-0\" }\n                                text \"全部照片\" { style: \"text-sm flex-1 text-left\" }\n                                text .cnt_all { style: \"text-xs text-muted-foreground\" }\n                            }\n                            button {\n                                onclick: .SelectAlbum(\"favorites\")\n                                style: if .album == \"favorites\" { \"w-full flex items-center gap-2.5 h-9 px-3 rounded-lg bg-accent/10 text-accent border-l-2 border-primary\" } else { \"w-full flex items-center gap-2.5 h-9 px-3 rounded-lg bg-transparent text-muted-foreground hover:bg-accent/40 border-l-2 border-transparent\" }\n                                text \"♡\" { style: \"text-sm shrink-0\" }\n                                text \"收藏\" { style: \"text-sm flex-1 text-left\" }\n                                text .cnt_favorites { style: \"text-xs text-muted-foreground\" }\n                            }\n                            button {\n                                onclick: .SelectAlbum(\"nature\")\n                                style: if .album == \"nature\" { \"w-full flex items-center gap-2.5 h-9 px-3 rounded-lg bg-accent/10 text-accent border-l-2 border-primary\" } else { \"w-full flex items-center gap-2.5 h-9 px-3 rounded-lg bg-transparent text-muted-foreground hover:bg-accent/40 border-l-2 border-transparent\" }\n                                text \"🏔️\" { style: \"text-sm shrink-0\" }\n                                text \"自然\" { style: \"text-sm flex-1 text-left\" }\n                                text .cnt_nature { style: \"text-xs text-muted-foreground\" }\n                            }\n                            button {\n                                onclick: .SelectAlbum(\"city\")\n                                style: if .album == \"city\" { \"w-full flex items-center gap-2.5 h-9 px-3 rounded-lg bg-accent/10 text-accent border-l-2 border-primary\" } else { \"w-full flex items-center gap-2.5 h-9 px-3 rounded-lg bg-transparent text-muted-foreground hover:bg-accent/40 border-l-2 border-transparent\" }\n                                text \"🏙️\" { style: \"text-sm shrink-0\" }\n                                text \"城市\" { style: \"text-sm flex-1 text-left\" }\n                                text .cnt_city { style: \"text-xs text-muted-foreground\" }\n                            }\n                            button {\n                                onclick: .SelectAlbum(\"sky\")\n                                style: if .album == \"sky\" { \"w-full flex items-center gap-2.5 h-9 px-3 rounded-lg bg-accent/10 text-accent border-l-2 border-primary\" } else { \"w-full flex items-center gap-2.5 h-9 px-3 rounded-lg bg-transparent text-muted-foreground hover:bg-accent/40 border-l-2 border-transparent\" }\n                                text \"☁️\" { style: \"text-sm shrink-0\" }\n                                text \"天空\" { style: \"text-sm flex-1 text-left\" }\n                                text .cnt_sky { style: \"text-xs text-muted-foreground\" }\n                            }\n                            button {\n                                onclick: .SelectAlbum(\"abstract\")\n                                style: if .album == \"abstract\" { \"w-full flex items-center gap-2.5 h-9 px-3 rounded-lg bg-accent/10 text-accent border-l-2 border-primary\" } else { \"w-full flex items-center gap-2.5 h-9 px-3 rounded-lg bg-transparent text-muted-foreground hover:bg-accent/40 border-l-2 border-transparent\" }\n                                text \"✨\" { style: \"text-sm shrink-0\" }\n                                text \"抽象\" { style: \"text-sm flex-1 text-left\" }\n                                text .cnt_abstract { style: \"text-xs text-muted-foreground\" }\n                            }\n                        }\n                    }\n\n                    // ---- 主区：工具栏 + 计数条 + 网格 ----\n                    col {\n                        style: \"flex-1 min-w-0 flex flex-col\"\n\n                        // 工具栏：搜索 / 排序 / 密度 / 主题\n                        row {\n                            style: \"h-14 shrink-0 items-center gap-2 px-4 border-b border-border\"\n                            input {\n                                value: .search_q\n                                oninput: .SetSearch\n                                placeholder: \"搜索照片…\"\n                                style: \"w-48 h-8 text-sm px-3 bg-card border border-border rounded-lg outline-none placeholder:text-muted-foreground focus:border-primary/50\"\n                            }\n                            button (text: .sort_label, variant: \"ghost\") {\n                                onclick: .ToggleSort\n                                style: \"h-8 px-2.5 text-xs rounded-lg border border-border text-muted-foreground hover:text-foreground\"\n                            }\n                            row {\n                                style: \"items-center bg-card border border-border rounded-lg p-0.5 gap-0.5\"\n                                button (text: \"2\", variant: \"ghost\") {\n                                    onclick: .SetDensity(2)\n                                    style: if .density == 2 { \"h-7 w-7 text-xs rounded-md bg-accent text-accent-foreground font-bold\" } else { \"h-7 w-7 text-xs rounded-md text-muted-foreground hover:text-foreground\" }\n                                }\n                                button (text: \"3\", variant: \"ghost\") {\n                                    onclick: .SetDensity(3)\n                                    style: if .density == 3 { \"h-7 w-7 text-xs rounded-md bg-accent text-accent-foreground font-bold\" } else { \"h-7 w-7 text-xs rounded-md text-muted-foreground hover:text-foreground\" }\n                                }\n                                button (text: \"4\", variant: \"ghost\") {\n                                    onclick: .SetDensity(4)\n                                    style: if .density == 4 { \"h-7 w-7 text-xs rounded-md bg-accent text-accent-foreground font-bold\" } else { \"h-7 w-7 text-xs rounded-md text-muted-foreground hover:text-foreground\" }\n                                }\n                            }\n                            spacer { style: \"flex-1\" }\n                            if .dark_mode {\n                                button {\n                                    onclick: .ToggleDark\n                                    style: \"h-8 w-8 rounded-lg bg-transparent hover:bg-transparent text-muted-foreground hover:text-foreground flex items-center justify-center\"\n                                    icon (name: \"moon\", size: 16)\n                                }\n                            } else {\n                                button {\n                                    onclick: .ToggleDark\n                                    style: \"h-8 w-8 rounded-lg bg-transparent hover:bg-transparent text-muted-foreground hover:text-foreground flex items-center justify-center\"\n                                    icon (name: \"sun\", size: 16)\n                                }\n                            }\n                            row {\n                                style: \"items-center gap-1 ml-1\"\n                                for a in .accents {\n                                    if .accent_color == a.name {\n                                        button (text: \"●\") {\n                                            onclick: .SetAccent(a.name)\n                                            style: \"h-7 w-7 p-0 bg-transparent text-lg ${a.dot}\"\n                                        }\n                                    } else {\n                                        button (text: \"●\") {\n                                            onclick: .SetAccent(a.name)\n                                            style: \"h-7 w-7 p-0 bg-transparent text-lg ${a.dot} opacity-40\"\n                                        }\n                                    }\n                                }\n                            }\n                        }\n\n                        // 计数条（view_label 由 handler 预拼）\n                        row {\n                            style: \"h-8 shrink-0 items-center px-4 border-b border-border\"\n                            text .view_label { style: \"text-xs text-muted-foreground\" }\n                        }\n\n                        // 网格滚动区\n                        col {\n                            style: \"flex-1 min-h-0 overflow-y-auto p-4\"\n                            if .has_view {\n                                // 密度三臂各用静态语义 grid（028 同款构造）：\n                                // cols prop / grid 元素均静态——VM 的 cols/类\n                                // 动态绑定双不解析（T7 实测），静态臂双端实证。\n                                if .density == 2 {\n                                    grid {\n                                        cols: 2\n                                        gap: 12\n                                        for item in .view_list {\n                                            col {\n                                                style: \"rounded-xl overflow-hidden border border-border bg-card hover:border-primary/50 transition-colors\"\n                                                // 图片区 = 打开点击区（button 子件形态，028 T12 实证）\n                                                button {\n                                                    onclick: .OpenPhoto(item.id)\n                                                    // h-auto 覆盖 button 变体默认 h-10\n                                                    // （cn/tailwind-merge 后者覆盖前者），\n                                                    // 否则图片溢出按钮盖住信息行。\n                                                    style: \"w-full h-auto p-0 border-0 rounded-none bg-transparent block cursor-pointer\"\n                                                    col {\n                                                        style: \"h-40 w-full overflow-hidden bg-muted\"\n                                                        image (src: item.thumb, alt: item.title, fit: \"cover\") {\n                                                            style: \"w-full h-full\"\n                                                        }\n                                                    }\n                                                }\n                                                // 信息行：标题点击开图 + 收藏按钮（兄弟节点，\n                                                // 无冒泡问题——待澄清①的落地形态）\n                                                row {\n                                                    style: \"items-center gap-1 px-3 py-2\"\n                                                    button {\n                                                        onclick: .OpenPhoto(item.id)\n                                                        // text-foreground 压过 button 变体\n                                                        // 默认 text-primary-foreground（深底深字）\n                                                        style: \"flex-1 min-w-0 h-6 py-0 p-0 border-0 bg-transparent justify-start text-foreground\"\n                                                        text item.title { style: \"text-sm font-medium truncate\" }\n                                                    }\n                                                    if item.fav {\n                                                        button (text: \"❤\", variant: \"ghost\") {\n                                                            onclick: .ToggleFav(item.id)\n                                                            style: \"shrink-0 h-7 w-7 p-0 text-sm text-red-400\"\n                                                        }\n                                                    } else {\n                                                        button (text: \"♡\", variant: \"ghost\") {\n                                                            onclick: .ToggleFav(item.id)\n                                                            style: \"shrink-0 h-7 w-7 p-0 text-sm text-muted-foreground\"\n                                                        }\n                                                    }\n                                                }\n                                            }\n                                        }\n                                    }\n                                } else if .density == 3 {\n                                    grid {\n                                        cols: 3\n                                        gap: 12\n                                        for item in .view_list {\n                                            col {\n                                                style: \"rounded-xl overflow-hidden border border-border bg-card hover:border-primary/50 transition-colors\"\n                                                // 图片区 = 打开点击区（button 子件形态，028 T12 实证）\n                                                button {\n                                                    onclick: .OpenPhoto(item.id)\n                                                    // h-auto 覆盖 button 变体默认 h-10\n                                                    // （cn/tailwind-merge 后者覆盖前者），\n                                                    // 否则图片溢出按钮盖住信息行。\n                                                    style: \"w-full h-auto p-0 border-0 rounded-none bg-transparent block cursor-pointer\"\n                                                    col {\n                                                        style: \"h-40 w-full overflow-hidden bg-muted\"\n                                                        image (src: item.thumb, alt: item.title, fit: \"cover\") {\n                                                            style: \"w-full h-full\"\n                                                        }\n                                                    }\n                                                }\n                                                // 信息行：标题点击开图 + 收藏按钮（兄弟节点，\n                                                // 无冒泡问题——待澄清①的落地形态）\n                                                row {\n                                                    style: \"items-center gap-1 px-3 py-2\"\n                                                    button {\n                                                        onclick: .OpenPhoto(item.id)\n                                                        // text-foreground 压过 button 变体\n                                                        // 默认 text-primary-foreground（深底深字）\n                                                        style: \"flex-1 min-w-0 h-6 py-0 p-0 border-0 bg-transparent justify-start text-foreground\"\n                                                        text item.title { style: \"text-sm font-medium truncate\" }\n                                                    }\n                                                    if item.fav {\n                                                        button (text: \"❤\", variant: \"ghost\") {\n                                                            onclick: .ToggleFav(item.id)\n                                                            style: \"shrink-0 h-7 w-7 p-0 text-sm text-red-400\"\n                                                        }\n                                                    } else {\n                                                        button (text: \"♡\", variant: \"ghost\") {\n                                                            onclick: .ToggleFav(item.id)\n                                                            style: \"shrink-0 h-7 w-7 p-0 text-sm text-muted-foreground\"\n                                                        }\n                                                    }\n                                                }\n                                            }\n                                        }\n                                    }\n                                } else if .density == 4 {\n                                    grid {\n                                        cols: 4\n                                        gap: 12\n                                        for item in .view_list {\n                                            col {\n                                                style: \"rounded-xl overflow-hidden border border-border bg-card hover:border-primary/50 transition-colors\"\n                                                // 图片区 = 打开点击区（button 子件形态，028 T12 实证）\n                                                button {\n                                                    onclick: .OpenPhoto(item.id)\n                                                    // h-auto 覆盖 button 变体默认 h-10\n                                                    // （cn/tailwind-merge 后者覆盖前者），\n                                                    // 否则图片溢出按钮盖住信息行。\n                                                    style: \"w-full h-auto p-0 border-0 rounded-none bg-transparent block cursor-pointer\"\n                                                    col {\n                                                        style: \"h-40 w-full overflow-hidden bg-muted\"\n                                                        image (src: item.thumb, alt: item.title, fit: \"cover\") {\n                                                            style: \"w-full h-full\"\n                                                        }\n                                                    }\n                                                }\n                                                // 信息行：标题点击开图 + 收藏按钮（兄弟节点，\n                                                // 无冒泡问题——待澄清①的落地形态）\n                                                row {\n                                                    style: \"items-center gap-1 px-3 py-2\"\n                                                    button {\n                                                        onclick: .OpenPhoto(item.id)\n                                                        // text-foreground 压过 button 变体\n                                                        // 默认 text-primary-foreground（深底深字）\n                                                        style: \"flex-1 min-w-0 h-6 py-0 p-0 border-0 bg-transparent justify-start text-foreground\"\n                                                        text item.title { style: \"text-sm font-medium truncate\" }\n                                                    }\n                                                    if item.fav {\n                                                        button (text: \"❤\", variant: \"ghost\") {\n                                                            onclick: .ToggleFav(item.id)\n                                                            style: \"shrink-0 h-7 w-7 p-0 text-sm text-red-400\"\n                                                        }\n                                                    } else {\n                                                        button (text: \"♡\", variant: \"ghost\") {\n                                                            onclick: .ToggleFav(item.id)\n                                                            style: \"shrink-0 h-7 w-7 p-0 text-sm text-muted-foreground\"\n                                                        }\n                                                    }\n                                                }\n                                            }\n                                        }\n                                        }\n                                    }\n                                } else {\n                                    col {\n                                        style: \"w-full flex flex-col items-center justify-center py-16 gap-2\"\n                                        text \"📷\" { style: \"text-4xl\" }\n                                        text \"未找到照片\" { style: \"text-sm text-muted-foreground\" }\n                                        text \"试试清除搜索或切换相册\" { style: \"text-xs text-muted-foreground/70\" }\n                                    }\n                                }\n                        }\n                    }\n                }\n            } else {\n                // ══════════ 查看器分支（T4）══════════\n                col {\n                    style: \"w-full h-full flex flex-col bg-background\"\n\n                    // 顶栏：返回 + 标题 + 收藏切换\n                    row {\n                        style: \"h-14 shrink-0 items-center gap-3 px-4 border-b border-border\"\n                        button (text: \"← 返回网格\", variant: \"ghost\") {\n                            onclick: .BackToGrid\n                            style: \"h-8 px-2.5 text-xs rounded-lg bg-transparent text-muted-foreground hover:text-foreground\"\n                        }\n                        spacer { style: \"flex-1\" }\n                        text .cur_title { style: \"text-sm font-semibold\" }\n                        spacer { style: \"flex-1\" }\n                        button (text: .fav_label, variant: \"ghost\") {\n                            onclick: .ToggleFav(.cur_id)\n                            style: \"h-8 px-3 text-xs rounded-lg border border-border bg-transparent text-foreground hover:border-primary/50\"\n                        }\n                    }\n\n                    // 大图区（contain 适配，黑场衬底）\n                    col {\n                        style: \"flex-1 min-h-0 flex items-center justify-center bg-black/80 p-4\"\n                        image (src: .cur_full, alt: .cur_title, fit: \"contain\") {\n                            style: \"max-w-full max-h-full\"\n                        }\n                    }\n\n                    // 底栏：prev/next 循环导航 + 元信息\n                    row {\n                        style: \"h-14 shrink-0 items-center gap-3 px-4 border-t border-border\"\n                        button {\n                            onclick: .PrevPhoto\n                            style: \"h-9 px-3 rounded-lg border border-border bg-transparent text-muted-foreground hover:text-foreground flex items-center gap-1.5\"\n                            icon (name: \"chevron-left\", size: 14)\n                            text \"上一张\" { style: \"text-xs\" }\n                        }\n                        button {\n                            onclick: .NextPhoto\n                            style: \"h-9 px-3 rounded-lg border border-border bg-transparent text-muted-foreground hover:text-foreground flex items-center gap-1.5\"\n                            text \"下一张\" { style: \"text-xs\" }\n                            icon (name: \"chevron-right\", size: 14)\n                        }\n                        spacer { style: \"flex-1\" }\n                        text .cur_meta { style: \"text-xs text-muted-foreground\" }\n                    }\n                }\n            }\n        }\n    }\n\n    on {\n        .Init -> {\n            // 构建主列表 photos（完整 struct 列表；URL 已拼好完整串）\n            var plist = []\n            var i int = 0\n            for i < .p_ids.len() {\n                var p = {\n                    id: .p_ids[i],\n                    title: .p_titles[i],\n                    album: .p_albums[i],\n                    seed: .p_seeds[i],\n                    date: .p_dates[i],\n                    fav: .p_favs[i],\n                    thumb: .p_thumbs[i],\n                    full: \"https://picsum.photos/seed/\" + .p_seeds[i] + \"/1600/1200\"\n                }\n                plist.push(p)\n                i = i + 1\n            }\n            .photos = plist\n            .ApplyFilter()\n        }\n\n        .SelectAlbum(a) -> {\n            .album = a\n            .ApplyFilter()\n        }\n\n        .SetSearch(q) -> {\n            .search_q = q\n            .ApplyFilter()\n        }\n\n        // 核心过滤器：album 过滤 → search_q 子串过滤（预小写域）→\n        // p_keys 按 sort_dir 排序 → 写 view_list/view_ids + 计数 + 文案。\n        // 被 Init/SelectAlbum/SetSearch/ToggleSort/ToggleFav 复用。\n        .ApplyFilter -> {\n            // 1) 收集命中下标（种子系下标）\n            var hits = []\n            var used = []\n            let ql str = .search_q.lower()\n            var i int = 0\n            for i < .p_ids.len() {\n                var album_match bool = false\n                if .album == \"all\" { album_match = true }\n                if .album == \"favorites\" { album_match = .p_favs[i] }\n                if .album != \"all\" && .album != \"favorites\" {\n                    album_match = .p_albums[i] == .album\n                }\n                let tl = .p_tls[i]\n                let tmatch = (ql == \"\") || tl.contains(ql)\n                if album_match && tmatch {\n                    hits.push(i)\n                    used.push(0)\n                }\n                i = i + 1\n            }\n\n            // 2) selection sort + used 标记（028 实证习语），整数键比较\n            var vlist = []\n            var vids = []\n            var n int = hits.len()\n            var placed int = 0\n            for placed < n {\n                var best int = -1\n                var best_key int = 0\n                var bi int = 0\n                for bi < n {\n                    if used[bi] == 0 {\n                        var k int = .p_keys[hits[bi]]\n                        var take bool = false\n                        if best == -1 { take = true }\n                        else {\n                            if .sort_dir == \"asc\" { take = k < best_key }\n                            if .sort_dir == \"desc\" { take = k > best_key }\n                        }\n                        if take {\n                            best = bi\n                            best_key = k\n                        }\n                    }\n                    bi = bi + 1\n                }\n                if best >= 0 {\n                    let si = hits[best]\n                    var p = {\n                        id: .p_ids[si],\n                        title: .p_titles[si],\n                        album: .p_albums[si],\n                        seed: .p_seeds[si],\n                        date: .p_dates[si],\n                        fav: .p_favs[si],\n                        thumb: .p_thumbs[si],\n                        full: \"https://picsum.photos/seed/\" + .p_seeds[si] + \"/1600/1200\"\n                    }\n                    vlist.push(p)\n                    vids.push(.p_ids[si])\n                    used[best] = 1\n                }\n                placed = placed + 1\n            }\n\n            .view_list = vlist\n            .view_ids = vids\n            .has_view = (vids.len() > 0)\n\n            // 3) 侧边栏六计数（全种子系统计，收藏数随 ToggleFav 联动）\n            var c_all int = 0\n            var c_fav int = 0\n            var c_nat int = 0\n            var c_city int = 0\n            var c_sky int = 0\n            var c_abs int = 0\n            var k int = 0\n            for k < .p_ids.len() {\n                c_all = c_all + 1\n                let alb = .p_albums[k]\n                if alb == \"nature\" { c_nat = c_nat + 1 }\n                if alb == \"city\" { c_city = c_city + 1 }\n                if alb == \"sky\" { c_sky = c_sky + 1 }\n                if alb == \"abstract\" { c_abs = c_abs + 1 }\n                if .p_favs[k] { c_fav = c_fav + 1 }\n                k = k + 1\n            }\n            .cnt_all = c_all.str()\n            .cnt_favorites = c_fav.str()\n            .cnt_nature = c_nat.str()\n            .cnt_city = c_city.str()\n            .cnt_sky = c_sky.str()\n            .cnt_abstract = c_abs.str()\n\n            // 4) 计数条文案（当前相册中文标签预拼）\n            var cur_label str = \"\"\n            if .album == \"all\" { cur_label = \"全部\" }\n            if .album == \"favorites\" { cur_label = \"收藏\" }\n            if .album == \"nature\" { cur_label = \"自然\" }\n            if .album == \"city\" { cur_label = \"城市\" }\n            if .album == \"sky\" { cur_label = \"天空\" }\n            if .album == \"abstract\" { cur_label = \"抽象\" }\n            if .search_q == \"\" {\n                .view_label = vids.len().str() + \" 张照片 · \" + cur_label\n            } else {\n                .view_label = vids.len().str() + \" 张照片 · 搜索 “\" + .search_q + \"” · \" + cur_label\n            }\n        }\n\n        .ToggleSort -> {\n            if .sort_dir == \"desc\" {\n                .sort_dir = \"asc\"\n                .sort_label = \"最早 ↑\"\n            } else {\n                .sort_dir = \"desc\"\n                .sort_label = \"最新 ↓\"\n            }\n            .ApplyFilter()\n        }\n\n        .SetDensity(d) -> {\n            .density = d\n        }\n\n        .OpenPhoto(pid) -> {\n            // 在当前视图内定位（view_ids 平行列表）\n            var pos int = -1\n            var n int = .view_ids.len()\n            var i int = 0\n            for i < n {\n                if .view_ids[i] == pid { pos = i }\n                i = i + 1\n            }\n            if pos >= 0 {\n                .mode = \"view\"\n                .cur_id = pid\n                // 循环导航预计算（单元素时 prev=next=自身）\n                var prev_pos int = pos - 1\n                if prev_pos < 0 { prev_pos = n - 1 }\n                var next_pos int = pos + 1\n                if next_pos >= n { next_pos = 0 }\n                .prev_id = .view_ids[prev_pos]\n                .next_id = .view_ids[next_pos]\n                // 元信息从种子系预取\n                var si int = -1\n                var j int = 0\n                for j < .p_ids.len() {\n                    if .p_ids[j] == pid { si = j }\n                    j = j + 1\n                }\n                if si >= 0 {\n                    .cur_title = .p_titles[si]\n                    .cur_full = \"https://picsum.photos/seed/\" + .p_seeds[si] + \"/1600/1200\"\n                    let alb = .p_albums[si]\n                    var alb_label str = \"\"\n                    if alb == \"nature\" { alb_label = \"自然\" }\n                    if alb == \"city\" { alb_label = \"城市\" }\n                    if alb == \"sky\" { alb_label = \"天空\" }\n                    if alb == \"abstract\" { alb_label = \"抽象\" }\n                    .cur_meta = alb_label + \" · \" + .p_dates[si] + \" · 1600×1200 · \" + .p_seeds[si]\n                    if .p_favs[si] {\n                        .fav_label = \"❤ 已收藏\"\n                    } else {\n                        .fav_label = \"♡ 收藏\"\n                    }\n                }\n            }\n        }\n\n        .PrevPhoto -> { .OpenPhoto(.prev_id) }\n        .NextPhoto -> { .OpenPhoto(.next_id) }\n        .BackToGrid -> { .mode = \"grid\" }\n\n        .ToggleFav(id) -> {\n            var i int = 0\n            for i < .p_ids.len() {\n                if .p_ids[i] == id {\n                    .p_favs[i] = !.p_favs[i]\n                }\n                i = i + 1\n            }\n            .ApplyFilter()\n            // 查看器内收藏时同步按钮文案\n            if .mode == \"view\" && .cur_id == id {\n                var si int = -1\n                var j int = 0\n                for j < .p_ids.len() {\n                    if .p_ids[j] == id { si = j }\n                    j = j + 1\n                }\n                if si >= 0 {\n                    if .p_favs[si] {\n                        .fav_label = \"❤ 已收藏\"\n                    } else {\n                        .fav_label = \"♡ 收藏\"\n                    }\n                }\n            }\n        }\n\n        .ToggleDark -> { .dark_mode = !.dark_mode }\n        .SetAccent(name) -> { .accent_color = name }\n    }\n}\n", pac_text: "// pac.at — 029-photo-gallery（Plan 537）。\n//\n// 图库：macOS 相册风图片浏览器——侧边栏相册导航 + 搜索/排序/网格密度\n// 工具栏 + 响应式缩略图网格 + 大图查看器（上一张/下一张/收藏）。\n// 全部基于既有 image widget 真实加载网络图片（picsum.photos 固定 seed），\n// 是该 widget 首个应用级双端示范（019/020 媒体 demo 封面均为渐变色块模拟）。\n//\n// render 声明 \"vue\"（开发目标端）；vm 兼容性由实机验收兜底（注册表扫描\n// 不过滤 render——声明的 render 是前端目标）。编号 029 回填空洞：原能力\n// 样板 029-external-imports 已迁 examples/capability-tests/（README 编号说明）。\n\nname: \"photo-gallery\"\nversion: \"0.1.0\"\ndescription: \"Photo Gallery - album sidebar, search/sort/density toolbar, thumbnail grid & fullscreen viewer (vue/vm)\"\n\nscene: \"ui\"\nrender: \"vue\"\nfront_port: 4029\nicon: \"image\"\ntitle: \"Photo Gallery\"\ncategory: \"media\"\ndesktop: \"true\"\n", loadable: true, search_lc: "photo gallery 029-photo-gallery images gallery modal" },
        { id: "030-video-player", title: "Video Player", category: "04-systems", icon: "film", description: "Video Player", tags: ["AutoUI"], doc: "# 030-video-player\n\n真实可播的本地视频播放器示范（Vue：`auto run`；VM：`auto run -r vm`）。\n\n> 本示例在 PLAN-617 里做过一次**真实化重做**：此前是「外壳真实、内核全假」\n> ——`<video>` 从未被播放过、OSD 全是常量、队列是写死的字面量。现在队列来自\n> 后端对媒体根的递归扫描，播放由受控契约驱动真实元素，界面只显示实测值。\n\n## 跑起来\n\n```bash\n# 媒体根已在 pac.at 写死为 E:\\Video（用户 r2 裁定方案 (a)）；\n# env 可覆盖：AUTO_MEDIA_ROOT 优先于 pac.at。\nexport AUTO_MEDIA_ROOT='E:\\Video'     # 可选；Windows: $env:AUTO_MEDIA_ROOT='E:\\Video'\n\nauto run          # Vue 模式：真后端（axum）+ Vite\nauto run -r vm    # VM/iced 模式（原生播放需另开 feature，见下）\n```\n\nVM 模式想看到**真实画面**（而不是降级面板）：\n\n```bash\ncargo build -p auto --features mpv          # 打开 mpv-native/mpv-gpu/mpv-widget\nAUTO_MPV_LIB=<dir-with-libmpv-2.dll> auto run -r vm\n```\n\nVM 模式想看到**真实媒体库**（队列与 Vue 端同一份数据）——先起生成后端，\n再给 VM 一个 HTTP 基址（T-10 起支持相对 URL 展开）：\n\n```bash\ncargo run --manifest-path examples/rust-workspace/030-video-player-back\nAUTO_HTTP_BASE=http://127.0.0.1:8330 auto run -r vm\n```\n\n未开 mpv feature 或找不到运行库时，视口给出显式降级说明\n（「本后端未启用原生播放」），**不留黑屏**；未设 `AUTO_HTTP_BASE` 时\n媒体库显示诚实空态文案。\n\n## 能做什么（都是真的）\n\n- **队列**：递归扫描媒体根的白名单文件（`mp4/m4v/webm/mkv/mov/avi`），\n  按相对目录分组、组内自然排序（`S01E02` 在 `S01E10` 之前）；\n  条目显示真实文件名与真实字节数。\n- **播放**：`<video>` 真实加载并播放。起播/暂停、seek、音量、静音、倍速、\n  上下曲**全部作用于元素属性**（不是只改界面文字）。\n- **时间/进度**：由 `timeupdate` / `loadedmetadata` 回灌驱动；没有预置常量。\n- **本地文件**（Web 端）：「打开本地视频文件」打开系统文件对话框，\n  选中即用 object URL 播放——不经过后端、不经过队列（T-09）。\n- **音轨标注**：播放超过 1s 仍解不出音频字节（Dolby Digital Plus 等\n  Chromium 无解码器的编码）时，界面**主动**标注「音轨不受支持」（AC-16b）；\n  解得出时不说任何音频信息。\n- **错误可见**：解码/加载失败时视口用错误面板替换纯黑，文案来自 `MediaError`；\n  后端不可达 / 媒体根目录不存在 / 目录为空 三种空态文案各不相同（T-10）。\n- **深浅主题**：顶栏开关真实切换（会同步 `<html>` 的 `dark` 类）。\n\n## 不做什么（如实说明）\n\n- **不显示推不出的元数据**：分辨率/编码/码率在不解复用时无从得知，\n  数据模型里根本没有这些字段。时长/画面尺寸只来自元素回灌。\n- **不声称有声**：Matroska 容器能解，但 Dolby Digital Plus (E-AC-3/Atmos)\n  音轨不被 Chromium 的 FFmpeg 构建支持，那类文件表现为**有画面无声音**\n  ——界面不假装有音频，并按上节的探针实测给出反向标注。\n- **本地文件选择仅 Web 端**：`file_picker.vue` 依赖浏览器 File API；\n  VM/iced 端按钮点击给出「仅 Web 端可用」的降级文案，不做假动作。\n- **VM 端 `AUTO_HTTP_BASE` 覆盖面**：get/post/put/delete/patch/json/request/\n  auth 臂支持相对 URL 按基址展开；download/stream/SSE 臂**未**覆盖\n  （这些原生的 URL 惯例是绝对地址）。\n\n## 验证\n\n```bash\n# 生成器侧契约与兼容性（在仓库根）\ncargo t vue_gen\n\n# Vue 端真实播放 e2e（需先 auto run + AUTO_MEDIA_ROOT）\ncd tests && pnpm install && pnpm exec playwright test\n#   注意：e2e 强制使用本机真实 Chrome（Playwright 自带 Chromium 不带\n#   H.264/AAC，videoWidth 恒为 0），见 tests/playwright.config.ts 注释。\n\n# VM 端诚实降级冒烟\nAUTO_BIN=<path-to-auto> node tests/vm-smoke.mjs\n```\n\n截图（双端、深浅）在 `tests/screenshots/`：\n`after_t08_vue_{dark,light,playing,mkv}.png` 与 `after_t08_vm_degrade.png`。\n", source: "// app.at — 030-video-player 根组件（PLAN-617 T-03/T-04：单文件 1193 行拆分为\n// 四个组件 + 一个 store）。\n//\n// 结构（§2.2 视觉语言：发丝线扁平布局，无卡片/阴影/毛玻璃/渐变）：\n//   h-12 顶栏（标题 + 主题 + 队列开关）\n//   中部 row：Viewport（视口，flex-1）+ Playlist（w-72，border-l）\n//   h-14 播控条 Controls（border-t）\n//\n// 状态与业务逻辑全在 player_store.at；三个子组件经 `use player_store` 直读\n// `.store.*`，事件由本组件薄转发（041-auto-edit 的既有形态）。\n// 视图内不出现 emoji（AC-04），图标名限定在 VM lucide 字形表闭集内。\n\nuse player_store: PlayerStore\nuse viewport: Viewport\nuse playlist: Playlist\nuse controls: Controls\n\nwidget App {\n    msg {\n        Init,\n        ToggleDarkMode,\n        TogglePlaylist\n    }\n\n    model {\n        // 主题两魔法变量放在**根 widget** 而不是 store 里（Plan 409 §8 的\n        // root-App 形态）：生成器的主题运行时（`:class=\"{dark: ...}\"` +\n        // 把 dark 类同步到 `<html>` + applyTheme/applyAccent）只在 widget\n        // 自己持有 `dark_mode` **且**持有 `accent_color` 时才发射。\n        // 放 store 里时，切换只会改根 div 的 class，而 `<html class=\"dark\">`\n        // （pac.at 的 theme 经 index.html 注入）仍然在 :root 上给着深色变量，\n        // 于是「切浅色没反应」——实测就是这个表现。\n        // 界面不再提供强调色选择器（§2.2），但这两个变量名是平台的魔法名，\n        // 必须存在于根 widget 才能拿到主题运行时。\n        var dark_mode bool = true\n        var accent_color str = \"indigo\"\n    }\n\n    view {\n        col {\n            style: \"w-full h-screen flex-col bg-background text-foreground overflow-hidden\"\n\n            // ══ 1. 顶栏 h-12 ══\n            row {\n                style: \"w-full h-12 items-center gap-3 px-4 border-b border-border bg-card\"\n\n                row {\n                    style: \"items-center gap-2\"\n                    icon (name: \"film\", size: 18, style: \"text-primary\")\n                    text \"Video Player\" { style: \"text-sm font-semibold tracking-tight\" }\n                }\n                if .store.has_current {\n                    text .store.current_file {\n                        style: \"text-xs text-muted-foreground font-mono\"\n                    }\n                }\n\n                col { style: \"flex-1\" }\n\n                row {\n                    style: \"items-center gap-1\"\n                    // 深浅主题\n                    if .dark_mode {\n                        button {\n                            onclick: .ToggleDarkMode\n                            style: \"theme-toggle w-8 h-7 items-center justify-center rounded-md text-muted-foreground hover:bg-muted hover:text-foreground cursor-pointer\"\n                            icon (name: \"sun\", size: 15)\n                        }\n                    } else {\n                        button {\n                            onclick: .ToggleDarkMode\n                            style: \"theme-toggle w-8 h-7 items-center justify-center rounded-md text-muted-foreground hover:bg-muted hover:text-foreground cursor-pointer\"\n                            icon (name: \"moon\", size: 15)\n                        }\n                    }\n                    // 队列显隐\n                    button {\n                        onclick: .TogglePlaylist\n                        style: \"theme-toggle w-8 h-7 items-center justify-center rounded-md text-muted-foreground hover:bg-muted hover:text-foreground cursor-pointer\"\n                        icon (name: \"panel-left\", size: 15)\n                    }\n                }\n            }\n\n            // ══ 2. 主体：视口 + 队列栏 ══\n            row {\n                style: \"w-full flex-1 min-h-0\"\n\n                col {\n                    style: \"flex-1 min-w-0 min-h-0\"\n                    Viewport()\n                }\n                if .store.show_playlist {\n                    Playlist()\n                }\n            }\n\n            // ══ 3. 播控条 h-14 ══\n            Controls()\n        }\n    }\n\n    on {\n        // 唯一的根 handler：真实扫描（内建/原生调用只留在根 handler，§5.6）。\n        .Init -> {\n            store.Load()\n        }\n        .ToggleDarkMode -> {\n            .dark_mode = !.dark_mode\n        }\n        .TogglePlaylist -> {\n            store.TogglePlaylist()\n        }\n    }\n}\n", pac_text: "// pac.at — 030-video-player（Plan 542 & Plan 605）\n//\n// AutoOS 原生视频播放器（对标 VLC / PotPlayer / IINA / MPC-HC）。\n// 专注纯粹无干扰的大视口视频播放，自动隐匿 OSD 专业播控条、高精度进度条、\n// 多档倍速调节、音量与静音、画幅切换、可折叠播放队列抽屉与全套键盘快捷键。\n// 与 019-video-app（Web 流媒体门户）形成清晰的场景区隔。\n\nname: \"video-player\"\nversion: \"0.1.0\"\ndescription: \"AutoOS System Video Player - minimal chromeless viewport, OSD controls & playlist (vue/vm)\"\n\nscene: \"ui\"\nrender: \"vue\"\napi: \"rust\"\nfront_port: 3030\nback_port: 8330\n// PLAN-617 T-11（用户 r2 裁定方案 (a)）：媒体根目录进 pac.at，env 可覆盖 ——\n// 解析序 AUTO_MEDIA_ROOT env → 此处 → 无（诚实空库）。生成的媒体服务\n// /api/media/scan 由此扫描（递归，白名单见 ui/media_service.rs）。\nmedia_root: \"E:\\\\Video\"\nicon: \"film\"\ntitle: \"Video Player\"\ncategory: \"media\"\ndesktop: \"true\"\ntheme: \"dark\"\naccent: \"indigo\"\n", loadable: false, search_lc: "video player 030-video-player autoui" },
        { id: "031-image-viewer", title: "Image Viewer", category: "03-apps", icon: "image", description: "Image Viewer", tags: ["AutoUI"], doc: "# 031 Image Viewer\n\n031-image-viewer is the AutoUI read-only image viewer example. It keeps file\nmetadata and viewport transforms in the front model; image bytes remain behind\nthe shared media URI and ImageSurface runtime.\n\n## Run modes\n\n```text\n# Vue + Rust backend\nauto run\n\n# VM merged (AutoUI MCP)\nauto run -r vm\n\n# Rust UI generation (merged mode is the default)\nauto run -r rust --server rust\n```\n\nThe Vue action file and deterministic fixtures live under tests/. The release\nperformance harness is tests/perf_release.ps1 and writes a local JSON report.\nThe control API is metadata-only: open, snapshot, navigate, request-view,\nclose, and stats never return encoded pixels or base64.\n\n## Scope\n\nSupported formats are static JPEG, PNG, and WebP. The UI covers open file or\ndirectory, fit/width/1:1, zoom, pan, rotation, fullscreen, keyboard controls,\nloading/error/empty states, and an 80 ms settle timer.\n\n", source: "// 031-image-viewer front UI (Plan 547 Tasks 29 and 33).\n// The model is metadata and transform state only; pixels stay behind the\n// shared media route and ImageSurface renderer.\nuse back.api: open_file, open_directory, current_uri, names, request_view, close_session, image_stats, navigate\n\nwidget App {\n    msg {\n        Init,\n        OpenFile,\n        OpenDirectory,\n        SelectImage(int),\n        ZoomIn,\n        ZoomOut,\n        FitContain,\n        FitWidth,\n        OneToOne,\n        RotateLeft,\n        RotateRight,\n        PanLeft,\n        PanRight,\n        NextImage,\n        PrevImage,\n        RefreshStats,\n        ToggleFullscreen,\n        ImageLoaded,\n        ImageFailed,\n        Wheel,\n        Pan,\n        DoubleClick,\n        SettleTick,\n        Close\n    }\n\n    model {\n        var view_state str = \"empty\"\n        var status str = \"Open a file or directory to begin\"\n        var stats str = \"\"\n        var session_id str = \"\"\n        var media_src str = \"\"\n        var media_alt str = \"\"\n        var selected_name str = \"\"\n        var selected_path str = \"\"\n        var image_count int = 0\n        var selected_index int = 0\n        var zoom float = 1.0\n        var offset_x float = 0.0\n        var offset_y float = 0.0\n        var rotation int = 0\n        var fit_mode str = \"contain\"\n        var is_fullscreen bool = false\n        var revision int = 0\n        var thumbnails = [\n            { id: 0, name: \"No images\", src: \"\" }\n        ]\n    }\n\n    timer {\n        SettleTick (every_ms: 80)\n    }\n\n    view {\n        col {\n            style: \"w-full h-screen flex-col bg-background text-foreground overflow-hidden\"\n            row {\n                style: \"h-12 shrink-0 items-center justify-between px-4 border-b border-border bg-card\"\n                row {\n                    style: \"items-center gap-2\"\n                    text \"🖼️\" { style: \"text-lg\" }\n                    h1 \"Image Viewer\" { style: \"text-lg font-semibold\" }\n                    text .status { style: \"text-xs text-muted-foreground ml-2 truncate max-w-sm\" }\n                }\n                row {\n                    style: \"items-center gap-1\"\n                    button \"Open File\" { onclick: .OpenFile, style: \"px-2.5 py-1.5 text-xs\" }\n                    button \"Open Directory\" { onclick: .OpenDirectory, style: \"px-2.5 py-1.5 text-xs\" }\n                    button \"Fullscreen\" { onclick: .ToggleFullscreen, style: \"px-2.5 py-1.5 text-xs\" }\n                        button \"Stats\" { onclick: .RefreshStats, style: \"px-2.5 py-1.5 text-xs\" }\n                }\n            }\n\n            row {\n                style: \"flex-1 min-h-0\"\n                col {\n                    style: \"w-52 shrink-0 border-r border-border bg-card p-3 gap-2 overflow-hidden\"\n                    row {\n                        style: \"items-center justify-between\"\n                        text \"Images\" { style: \"text-xs font-semibold\" }\n                        text .image_count { style: \"text-xs text-muted-foreground\" }\n                    }\n                    if .image_count == 0 {\n                        text \"No images yet\" { style: \"text-xs text-muted-foreground p-2\" }\n                    } else {\n                        col {\n                            style: \"flex-1 min-h-0\"\n                            col {\n                                style: \"gap-1\"\n                                for item in .thumbnails {\n                                    button item.name {\n                                        onclick: .SelectImage(item.id),\n                                        style: \"w-full text-left px-2 py-1.5 text-xs rounded hover:bg-muted\"\n                                    }\n                                }\n                            }\n                        }\n                    }\n                }\n\n                col {\n                    style: \"flex-1 min-w-0 min-h-0\"\n                    row {\n                        style: \"h-10 shrink-0 items-center justify-center gap-1 border-b border-border\"\n                        button \"◀\" { onclick: .PrevImage, style: \"w-8 h-7\" }\n                        button \"▶\" { onclick: .NextImage, style: \"w-8 h-7\" }\n                        button \"−\" { onclick: .ZoomOut, style: \"w-8 h-7\" }\n                        text \"Zoom\" { style: \"text-xs text-muted-foreground px-2\" }\n                        button \"+\" { onclick: .ZoomIn, style: \"w-8 h-7\" }\n                        button \"Fit\" { onclick: .FitContain, style: \"px-2 text-xs\" }\n                        button \"Width\" { onclick: .FitWidth, style: \"px-2 text-xs\" }\n                        button \"1:1\" { onclick: .OneToOne, style: \"px-2 text-xs\" }\n                        button \"↺\" { onclick: .RotateLeft, style: \"w-8 h-7\" }\n                        button \"↻\" { onclick: .RotateRight, style: \"w-8 h-7\" }\n                    }\n\n                    col {\n                        style: \"flex-1 min-h-0 items-center justify-center p-3 bg-muted/20\"\n                        if .view_state == \"empty\" {\n                            col {\n                                style: \"items-center justify-center gap-2\"\n                                text \"🖼️\" { style: \"text-5xl opacity-40\" }\n                                text \"Choose an image file or directory\" { style: \"text-sm text-muted-foreground\" }\n                            }\n                        } else if .view_state == \"loading\" {\n                            text \"Loading image…\" { style: \"text-sm text-muted-foreground\" }\n                        } else if .view_state == \"error\" {\n                            col {\n                                style: \"items-center justify-center gap-2\"\n                                text \"Unable to load image\" { style: \"text-sm text-destructive\" }\n                                button \"Retry\" { onclick: .OpenFile, style: \"px-3 py-1.5 text-xs\" }\n                            }\n                        } else {\n                            image_surface (\n                                src: .media_src,\n                                alt: .media_alt,\n                                fit: .fit_mode,\n                                zoom: .zoom,\n                                offset_x: .offset_x,\n                                offset_y: .offset_y,\n                                rotation: .rotation,\n                                onload: .ImageLoaded,\n                                onerror: .ImageFailed,\n                                onwheel: .Wheel,\n                                onpan: .Pan,\n                                ondblclick: .DoubleClick,\n                                style: \"w-full h-full\"\n                            ) {}\n                        }\n                    }\n\n                    row {\n                        style: \"h-9 shrink-0 items-center justify-between px-3 border-t border-border bg-card\"\n                        text .selected_name { style: \"text-xs font-medium truncate\" }\n                        text .selected_path { style: \"text-[11px] text-muted-foreground truncate max-w-md\" }\n                    }\n                }\n            }\n        }\n    }\n\n    bind {\n        \"ArrowLeft\" -> .RotateLeft\n        \"ArrowRight\" -> .RotateRight\n        \"a\" -> .PanLeft\n        \"A\" -> .PanLeft\n        \"d\" -> .PanRight\n        \"D\" -> .PanRight\n        \"s\" -> .RefreshStats\n        \"S\" -> .RefreshStats\n        \"n\" -> .NextImage\n        \"p\" -> .PrevImage\n        \"+\" -> .ZoomIn\n        \"-\" -> .ZoomOut\n        \"0\" -> .FitContain\n        \"1\" -> .OneToOne\n        \"F\" -> .ToggleFullscreen\n        \"Escape\" -> .Close\n    }\n\n    on {\n        .Init -> {\n            .view_state = \"empty\"\n            .status = \"Open a file or directory to begin\"\n        }\n        .OpenFile -> {\n            .view_state = \"loading\"\n            .status = \"Reading image metadata…\"\n            if .session_id != \"\" {\n                let _closed = close_session(.session_id)\n            }\n            let session = open_file(\"../../tests/fixtures/scenic-320x240.png\")\n            .session_id = session\n            .media_src = current_uri(session)\n            .media_alt = \"Selected image\"\n            .selected_name = \"rgb-1x1.png\"\n            .selected_path = \"tests/fixtures\"\n            .image_count = 1\n            .thumbnails = [{ id: 0, name: \"rgb-1x1.png\", src: \"\" }]\n            .selected_index = 0\n            .revision = .revision + 1\n        }\n        .OpenDirectory -> {\n            .view_state = \"loading\"\n            .status = \"Indexing directory…\"\n            if .session_id != \"\" {\n                let _closed = close_session(.session_id)\n            }\n            let session = open_directory(\"../../tests/fixtures\")\n            .session_id = session\n            .media_src = current_uri(session)\n            .media_alt = \"Selected image\"\n            .selected_name = \"Opening directory…\"\n            .selected_path = \"tests/fixtures\"\n            .revision = .revision + 1\n        }\n        .SelectImage(i) -> {\n            .selected_index = i\n            if .session_id != \"\" {\n                request_view(.session_id, i, 1024, 768, 90)\n                .media_src = current_uri(.session_id)\n                .status = \"Queued rendition\"\n            }\n            .view_state = \"loading\"\n            .revision = .revision + 1\n        }\n        .ZoomIn -> {\n            .zoom = .zoom + 0.1\n            .fit_mode = \"free\"\n        }\n        .ZoomOut -> {\n            if .zoom > 0.2 { .zoom = .zoom - 0.1 }\n            .fit_mode = \"free\"\n        }\n        .FitContain -> { .fit_mode = \"contain\"; .zoom = 1.0; .offset_x = 0.0; .offset_y = 0.0 }\n        .FitWidth -> { .fit_mode = \"width\"; .zoom = 1.0 }\n        .OneToOne -> { .fit_mode = \"one-to-one\"; .zoom = 1.0 }\n        .RotateLeft -> { .rotation = (.rotation + 270) % 360 }\n        .RotateRight -> { .rotation = (.rotation + 90) % 360 }\n        .NextImage -> {\n            if .session_id != \"\" {\n                if .selected_index + 1 < .image_count {\n                    let _nav = navigate(.session_id, 1)\n                    .selected_index = .selected_index + 1\n                    .media_src = current_uri(.session_id)\n                    .status = \"Next\"\n                }\n            }\n        }\n        .PrevImage -> {\n            if .session_id != \"\" {\n                if .selected_index > 0 {\n                    let _nav = navigate(.session_id, -1)\n                    .selected_index = .selected_index - 1\n                    .media_src = current_uri(.session_id)\n                    .status = \"Prev\"\n                }\n            }\n        }\n        .RefreshStats -> { if .session_id != \"\" { .stats = image_stats(.session_id) } }\n        .PanLeft -> { .offset_x = .offset_x - 40.0; .fit_mode = \"free\" }\n        .PanRight -> { .offset_x = .offset_x + 40.0; .fit_mode = \"free\" }\n        .ToggleFullscreen -> { .is_fullscreen = !.is_fullscreen }\n        .ImageLoaded -> { .view_state = \"ready\"; .status = \"Ready\" }\n        // A media ticket can briefly be 503 while the bounded worker publishes\n        // its rendition. Keep the viewport mounted so the browser can retry\n        // the opaque URI; only an empty URI is a terminal error.\n        .ImageFailed -> {\n            .status = \"Waiting for image worker…\"\n            if .media_src == \"\" { .view_state = \"error\"; .status = \"Image failed to load\" }\n        }\n        .Wheel -> { .zoom = .zoom + 0.1; .fit_mode = \"free\" }\n        .Pan -> { .offset_x = .offset_x + 8.0; .offset_y = .offset_y + 4.0 }\n        .DoubleClick -> { .fit_mode = \"one-to-one\"; .zoom = 1.0 }\n        .SettleTick -> {\n            if .view_state == \"loading\" {\n                if .session_id != \"\" {\n                    .media_src = current_uri(.session_id)\n                    let names_list = names(.session_id)\n                    .image_count = names_list.len()\n                    var thumb_list = []\n                    var j int = 0\n                    for j < names_list.len() {\n                        thumb_list.push({ id: j, name: names_list[j], src: \"\" })\n                        j = j + 1\n                    }\n                    if names_list.len() > 0 {\n                        .thumbnails = thumb_list\n                        .media_src = current_uri(.session_id)\n                        if .selected_name == \"Opening directory…\" { .selected_name = names_list[0] }\n                        .view_state = \"ready\"\n                        .status = \"Ready\"\n                    }\n                }\n            }\n        }\n        .Close -> {\n            if .session_id != \"\" {\n                let _closed = close_session(.session_id)\n            }\n            .view_state = \"empty\"\n            .media_src = \"\"\n            .session_id = \"\"\n            .image_count = 0\n            .selected_name = \"\"\n            .selected_path = \"\"\n            .status = \"Closed\"\n        }\n    }\n}\n", pac_text: "// pac.at — 031-image-viewer (Plan 547).\n//\n// Full-stack media viewer shell. The initial skeleton deliberately keeps the\n// front/back contracts small; later tasks add indexing, sessions, controls and\n// deterministic verification fixtures.\nname: \"image-viewer\"\nversion: \"0.1.0\"\ndescription: \"AutoOS Image Viewer - asynchronous media surface and directory browsing\"\n\nscene: \"ui\"\nrender: \"vue\"\napi: \"rust\"\nfront_port: 3031\nback_port: 8031\nicon: \"image\"\ntitle: \"Image Viewer\"\ncategory: \"media\"\ndesktop: \"true\"\ntheme: \"dark\"\naccent: \"indigo\"\n", loadable: false, search_lc: "image viewer 031-image-viewer autoui" },
        { id: "031-paint", title: "Paint", category: "03-apps", icon: "pencil", description: "Paint", tags: ["AutoUI"], doc: "# 031-paint — 像素画板 SPEC（Plan 553）\n\n> AutoOS \"画图\"应用的 v1 形态：16×16 像素画板。真画布原语（连续笔迹）见\n> Plan 553 待澄清①，不在本应用范围。\n\n## 功能清单\n\n- 工具四件：铅笔（点击染当前色）/ 橡皮（点击染回白）/ 油漆桶（连通同色区\n  泛洪）/ 吸管（取格色为当前色）。\n- 调色板 16 色 + 当前色块；undo/redo（快照栈上限 20）；清空 / 新建。\n- 作品持久化：storage `paint.canvas.v1`（整串 `#rrggbb` ×256 以 `|` join）。\n\n## 状态模型（单组件内聚，028/025 形态）\n\n- **颜色表示**：颜色一律以完整 Tailwind 类串存状态（`\" bg-[#ef4444] \"`，\n  前后各一空格）——字面量随 handler 源进 vue 生成码命中 Tailwind JIT 扫描\n  （运行时拼接的任意值类不可见，T3 实测）；段间空格编进值本身，绕开生成器\n  `${}` 段接 `+` 拼接丢边界空白的问题（gen App.vue 实证）；VM 侧同机制\n  （028 launcher chip 先例）。\n- `px`：256 长度**类串**平行列表（B12 规避——VM handler 对 Obj 数组字段读\n  的失效面）。\n- `cells`：handler 自建行对象 `{i, chip}`（view 侧读自建 Obj 数组已证可用，\n  028 `ranked` 先例），每次变更后 `RebuildCells` 全量重建。\n- 画布 grid 用**表达式 cols**（`cols: .canvas_cols` → 内联\n  `grid-template-columns: repeat(16,…)`）——字面量 int 走 `grid-cols-N` 类，\n  N=16 超 Tailwind 默认刻度(≤12)不生成（ui_gen/vue.rs 10289 注记；038 动态\n  列同型）。\n- undo/redo 栈：`px.join(\"|\")` 快照串列表（044 `.join` / `Str.split` 实存）。\n\n## 双端注记\n\n- 拖画：v1 点击画（T1c——无按压门控的指针流，hover 刷不合画笔语义）。\n- 格子着色经 style 插值 `bg-[<色>]`（028 chip 同机制，双端同源）。\n- icon：lucide VM 闭集无 `brush`，取 `pencil`（T1b）。\n- **VM 变更纪律（T6 实测）**：运行时 **str 状态列表禁止下标写**（`.px[i]=v`\n  静默不生效——saved 翻转证分支执行、px 不变）；一律本地构建 → 整体赋值\n  （028 `.recent = nr` 同型）。单格 `SetPx` 全量拷贝，泛洪 BFS 只算 seen 再\n  单趟重建。\n- **VM 债 P553-D1**：split 产物重建的**全同串列表**整体赋值后塌缩为单元素\n  （uniform 快照恢复 px len=1；`+\"\"` 新鲜句柄无效；逐格 SetPx 恢复触预算\n  截断）。影响：全同盘的 Redo/Load 恢复（desktop_mcp T6-redo 按债引用式\n  SKIP，013 audit-B12 同型惯例）。混合内容快照不受影响。\n- **MCP harness 经验**：VM app 首帧前日志量大，子进程 stdout 必须 DEVNULL\n  （PIPE 塞满致写阻塞、UI 永不渲染）；重渲染改变 vnode 哈希 id——每次交互\n  组前必须重取快照重发现元素。\n\n## 测试\n\n- `tests/desktop_mcp.py`：VM 轨八组断言（结构/初始态/染格/橡皮/泛洪/\n  撤销重做/吸管/存取），30 PASS + 1 SKIP（P553-D1）。\n- vue 轨：playwright 冒烟（scratch/p553/ 截图族——手画/泛洪/撤销/存取像素\n  校验）。\n", source: "// app.at — 031-paint 像素画板根组件（Plan 553）。\n//\n// 形态：单组件内聚（025/028 形态——store 子组件 vue TS 生成损坏先例 013/038，\n// 全部状态进 App model）。\n//\n// 颜色表示（T3 实测修正，scratch/p553/）：颜色一律以 **完整 Tailwind 类串**\n// 形式存状态（如 \" bg-[#ef4444] \"，前后各一空格）——\n//   - 字面量随 model/handler 源进 vue 生成码 → Tailwind JIT 扫描命中\n//     （运行时拼接的任意值类不会进扫描面，T3 冒烟实证）；\n//   - 段间空格编进值本身：生成器把 style 的 ${} 段接为 `+` 拼接时会丢\n//     段边界空白（gen App.vue:192 实证），类值自带空格后拼接恒有效；\n//   - VM 侧同机制（028 launcher bg-[<color>21] chip 先例）。\n//\n// 变更纪律（T6 VM 实测修正）：**运行时 str 列表禁止下标写**（`.px[i] = v`\n// 静默不生效——saved 翻转证分支执行、px 不变实证；038 下标写是 Obj 列表\n// +store 形态、028 从不下标写）。一律本地构建新列表 → 整体赋值 `.px = np`\n// （028 `.recent = nr` 同型）。单格改动走 `.SetPx`（256 拷贝），泛洪 BFS\n// 只算 seen 标记再单趟重建。\n//\n// 其余状态表示（T1 探针）：cells/swatches handler 自建行对象（view 读自建\n// Obj 数组已证可用）；快照 join(\"|\")/split；BFS 邻接判定 `h%16`/`h>=16`/\n// `h<240` 边界式绕开整数除法。拖画：v1 点击画（T1c——无按压门控指针流）。\n\nwidget App {\n    msg {\n        Init, SetTool(str), SetCur(str), Paint(int), Fill(int), SetPx(int, str),\n        PushUndo, Undo, Redo, ApplySnap(str), Clear, New, Save, Load\n    }\n\n    model {\n        // ---- 颜色词汇表（17 个字面类；白色 = 橡皮色）----\n        var white str = \" bg-[#ffffff] \"\n        var palette = [\n            \" bg-[#111827] \", \" bg-[#ef4444] \", \" bg-[#f97316] \", \" bg-[#f59e0b] \",\n            \" bg-[#84cc16] \", \" bg-[#22c55e] \", \" bg-[#14b8a6] \", \" bg-[#3b82f6] \",\n            \" bg-[#6366f1] \", \" bg-[#a855f7] \", \" bg-[#ec4899] \", \" bg-[#92400e] \",\n            \" bg-[#57534e] \", \" bg-[#a8a29e] \", \" bg-[#e7e5e4] \", \" bg-[#ffffff] \"\n        ]\n\n        // ---- 画布 ----\n        var canvas_cols int = 16   // 表式 cols → 生成内联 grid-template-columns\n                                   // （字面量 int 走 grid-cols-N 类，N>12 超\n                                   // Tailwind 刻度不生成——ui_gen/vue.rs 10289；\n                                   // 038 动态列同型）\n        var px = []                 // 256 × 类串（初始全 white）\n        var cells = []              // {i, chip} 行对象（handler 重建）\n\n        // ---- 工具与当前色 ----\n        var tool str = \"pencil\"     // pencil | eraser | fill | picker\n        var cur str = \" bg-[#111827] \"\n        var swatches = []           // {c, chip, sel} 行对象（handler 重建）\n        var pencil_class str = \"\"\n        var eraser_class str = \"\"\n        var fill_class str = \"\"\n        var picker_class str = \"\"\n\n        // ---- 历史 ----\n        var undo_stack = []         // 快照串列表，上限 20\n        var redo_stack = []\n        var saved str = \"1\"         // \"0\" = 有未保存改动（标题行 ● 提示）\n\n        // ---- 状态条 ----\n        var status str = \"\"\n    }\n\n    view {\n        col {\n            style: \"w-full max-w-2xl bg-card border rounded-2xl shadow-2xl p-4 gap-3\"\n\n            // ---- 标题 + 工具行 ----\n            row {\n                style: \"items-center gap-2 flex-wrap\"\n                text \"Paint\" { style: \"text-base font-semibold text-foreground mr-2\" }\n                if .saved == \"0\" {\n                    text \"●\" { style: \"text-xs text-primary\" }\n                }\n                button \"✏ Pencil\" { onclick: .SetTool(\"pencil\"), style: .pencil_class }\n                button \"◻ Eraser\" { onclick: .SetTool(\"eraser\"), style: .eraser_class }\n                button \"🪣 Fill\" { onclick: .SetTool(\"fill\"), style: .fill_class }\n                button \"💧 Picker\" { onclick: .SetTool(\"picker\"), style: .picker_class }\n            }\n\n            // ---- 画布（16×16；容器 muted 底透 gap 成网格线）----\n            col {\n                style: \"p-1 bg-muted/50 border rounded-lg w-fit\"\n                grid {\n                    cols: .canvas_cols\n                    gap: 1\n                    for c in .cells {\n                        col {\n                            onclick: .Paint(c.i)\n                            style: \"w-5 h-5${c.chip}cursor-pointer\"\n                        }\n                    }\n                }\n            }\n\n            // ---- 调色板（当前色块 + 8×2 色板）----\n            row {\n                style: \"items-center gap-3\"\n                col {\n                    style: \"flex flex-col items-center gap-1\"\n                    col {\n                        style: \"w-8 h-8 rounded-lg border${.cur}\"\n                    }\n                    text \"Current\" { style: \"text-xs text-muted-foreground\" }\n                }\n                grid {\n                    cols: 8\n                    gap: 1\n                    for s in .swatches {\n                        col {\n                            onclick: .SetCur(s.c)\n                            style: \"w-6 h-6 rounded${s.chip}${s.sel}cursor-pointer\"\n                        }\n                    }\n                }\n            }\n\n            // ---- 操作行 + 状态条 ----\n            row {\n                style: \"items-center gap-2 flex-wrap\"\n                button \"Undo\" { onclick: .Undo, style: \"px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80\" }\n                button \"Redo\" { onclick: .Redo, style: \"px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80\" }\n                button \"Clear\" { onclick: .Clear, style: \"px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80\" }\n                button \"New\" { onclick: .New, style: \"px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80\" }\n                button \"Save\" { onclick: .Save, style: \"px-3 py-1.5 text-sm rounded-lg bg-primary text-primary-foreground\" }\n                button \"Load\" { onclick: .Load, style: \"px-3 py-1.5 text-sm rounded-lg bg-primary/15 text-primary\" }\n                text .status { style: \"ml-auto text-xs text-muted-foreground\" }\n            }\n        }\n    }\n\n    on {\n        .Init -> {\n            var ip = []\n            var k int = 0\n            while k < 256 {\n                ip.push(.white)\n                k = k + 1\n            }\n            .px = ip\n            .undo_stack = []\n            .redo_stack = []\n            .saved = \"1\"\n            .status = \"\"\n            .tool = \"pencil\"\n            .cur = \" bg-[#111827] \"\n            .ToolClasses()\n            .Swatches()\n            .RebuildCells()\n        }\n\n        // ---- 工具/当前色（选中态经 class 串状态，038 难度按钮同型）----\n        .SetTool(t) -> {\n            .tool = t\n            .ToolClasses()\n            .status = \"\"\n        }\n\n        .SetCur(c) -> {\n            .cur = c\n            .Swatches()\n            .status = \"\"\n        }\n\n        .ToolClasses -> {\n            if .tool == \"pencil\" {\n                .pencil_class = \"px-3 py-1.5 text-sm rounded-lg bg-primary/15 text-primary\"\n                .eraser_class = \"px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80\"\n                .fill_class = \"px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80\"\n                .picker_class = \"px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80\"\n            }\n            if .tool == \"eraser\" {\n                .pencil_class = \"px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80\"\n                .eraser_class = \"px-3 py-1.5 text-sm rounded-lg bg-primary/15 text-primary\"\n                .fill_class = \"px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80\"\n                .picker_class = \"px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80\"\n            }\n            if .tool == \"fill\" {\n                .pencil_class = \"px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80\"\n                .eraser_class = \"px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80\"\n                .fill_class = \"px-3 py-1.5 text-sm rounded-lg bg-primary/15 text-primary\"\n                .picker_class = \"px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80\"\n            }\n            if .tool == \"picker\" {\n                .pencil_class = \"px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80\"\n                .eraser_class = \"px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80\"\n                .fill_class = \"px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80\"\n                .picker_class = \"px-3 py-1.5 text-sm rounded-lg bg-primary/15 text-primary\"\n            }\n        }\n\n        .Swatches -> {\n            .swatches = []\n            var k int = 0\n            while k < .palette.len() {\n                var sel str = \" border border-transparent \"\n                if .palette[k] == .cur {\n                    sel = \" border border-primary \"\n                }\n                .swatches.push({ c: .palette[k], chip: .palette[k], sel: sel })\n                k = k + 1\n            }\n        }\n\n        .RebuildCells -> {\n            .cells = []\n            var k int = 0\n            while k < 256 {\n                .cells.push({ i: k, chip: .px[k] })\n                k = k + 1\n            }\n        }\n\n        // ---- 单格替换（本地构建 → 整体赋值；下标写静默失效，见文件头）----\n        .SetPx(i, v) -> {\n            var np = []\n            var k int = 0\n            while k < 256 {\n                if k == i {\n                    np.push(v)\n                } else {\n                    np.push(.px[k])\n                }\n                k = k + 1\n            }\n            .px = np\n        }\n\n        // ---- 落笔分派 ----\n        .Paint(i) -> {\n            if .tool == \"pencil\" {\n                if .px[i] != .cur {\n                    .PushUndo()\n                    .SetPx(i, .cur)\n                    .RebuildCells()\n                }\n            }\n            if .tool == \"eraser\" {\n                if .px[i] != .white {\n                    .PushUndo()\n                    .SetPx(i, .white)\n                    .RebuildCells()\n                }\n            }\n            if .tool == \"fill\" {\n                .Fill(i)\n            }\n            if .tool == \"picker\" {\n                .cur = .px[i]\n                .Swatches()\n            }\n        }\n\n        // ---- 历史栈 ----\n        .PushUndo -> {\n            .undo_stack.push(.px.join(\"|\"))\n            if .undo_stack.len() > 20 {\n                var kept = []\n                var k int = 1\n                while k < .undo_stack.len() {\n                    kept.push(.undo_stack[k])\n                    k = k + 1\n                }\n                .undo_stack = kept\n            }\n            .redo_stack = []\n            .saved = \"0\"\n        }\n\n        // ---- 泛洪（迭代 BFS 只算 seen 标记——变更集即 seen；随后单趟\n        // 重建整体赋值。队列 int 列表 + qi 游标，禁递归；邻接用\n        // h%16 / h>=16 / h<240 边界式绕开整数除法）----\n        .Fill(i) -> {\n            var target = .px[i]\n            if target != .cur {\n                .PushUndo()\n                var queue = []\n                queue.push(i)\n                var seen = []\n                var k int = 0\n                while k < 256 {\n                    seen.push(0)\n                    k = k + 1\n                }\n                seen[i] = 1\n                var qi int = 0\n                while qi < queue.len() {\n                    var h int = queue[qi]\n                    qi = qi + 1\n                    if h >= 16 {\n                        var up int = h - 16\n                        if seen[up] == 0 {\n                            if .px[up] == target {\n                                seen[up] = 1\n                                queue.push(up)\n                            }\n                        }\n                    }\n                    if h < 240 {\n                        var dn int = h + 16\n                        if seen[dn] == 0 {\n                            if .px[dn] == target {\n                                seen[dn] = 1\n                                queue.push(dn)\n                            }\n                        }\n                    }\n                    if h % 16 != 0 {\n                        var lf int = h - 1\n                        if seen[lf] == 0 {\n                            if .px[lf] == target {\n                                seen[lf] = 1\n                                queue.push(lf)\n                            }\n                        }\n                    }\n                    if h % 16 != 15 {\n                        var rt int = h + 1\n                        if seen[rt] == 0 {\n                            if .px[rt] == target {\n                                seen[rt] = 1\n                                queue.push(rt)\n                            }\n                        }\n                    }\n                }\n                // 单趟重建：seen 位 → cur，否则原色\n                var np = []\n                var k2 int = 0\n                while k2 < 256 {\n                    if seen[k2] == 1 {\n                        np.push(.cur)\n                    } else {\n                        np.push(.px[k2])\n                    }\n                    k2 = k2 + 1\n                }\n                .px = np\n                .RebuildCells()\n            }\n        }\n\n        // ---- 撤销/重做（快照互倒；栈丢底重建）----\n        .Undo -> {\n            if .undo_stack.len() > 0 {\n                .redo_stack.push(.px.join(\"|\"))\n                var last int = .undo_stack.len() - 1\n                var snap = .undo_stack[last]\n                var kept = []\n                var k int = 0\n                while k < last {\n                    kept.push(.undo_stack[k])\n                    k = k + 1\n                }\n                .undo_stack = kept\n                .ApplySnap(snap)\n                .saved = \"0\"\n            } else {\n                .status = \"nothing to undo\"\n            }\n        }\n\n        .Redo -> {\n            if .redo_stack.len() > 0 {\n                var last2 int = .redo_stack.len() - 1\n                var snap2 = .redo_stack[last2]\n                var kept2 = []\n                var k2 int = 0\n                while k2 < last2 {\n                    kept2.push(.redo_stack[k2])\n                    k2 = k2 + 1\n                }\n                var cur_snap = .px.join(\"|\")\n                .redo_stack = kept2\n                .ApplySnap(snap2)\n                .undo_stack.push(cur_snap)\n                .saved = \"0\"\n            } else {\n                .status = \"nothing to redo\"\n            }\n        }\n\n        // ---- 快照应用（本地构建 → 整体赋值）。已知 VM 债 P553-D1：split\n        // 产物重建的**全同串列表**整体赋值后塌缩为单元素（uniform 快照恢复\n        // px len=1，实测；逐格 SetPx 恢复则触预算截断——两害取整体赋值，\n        // 混合内容快照不受影响；债见 KNOWN-DEBT P553-D1）。----\n        .ApplySnap(s) -> {\n            var parts = s.split(\"|\")\n            if parts.len() == 256 {\n                var np = []\n                var k int = 0\n                while k < 256 {\n                    np.push(parts[k])\n                    k = k + 1\n                }\n                .px = np\n                .RebuildCells()\n            }\n        }\n\n        // ---- 清空（可撤销）/ 新建（清历史）----\n        .Clear -> {\n            var dirty int = 0\n            var k int = 0\n            while k < 256 {\n                if .px[k] != .white {\n                    dirty = 1\n                }\n                k = k + 1\n            }\n            if dirty == 1 {\n                .PushUndo()\n                var np = []\n                var k2 int = 0\n                while k2 < 256 {\n                    np.push(.white)\n                    k2 = k2 + 1\n                }\n                .px = np\n                .RebuildCells()\n                .status = \"\"\n            }\n        }\n\n        .New -> {\n            var np = []\n            var k int = 0\n            while k < 256 {\n                np.push(.white)\n                k = k + 1\n            }\n            .px = np\n            .undo_stack = []\n            .redo_stack = []\n            .saved = \"0\"\n            .RebuildCells()\n            .status = \"new canvas\"\n        }\n\n        // ---- storage 存取（null 防御在 lowering 层：storage.get 产物\n        // ?? '' 对齐 VM \"\" 缺省——PLAN-553 ts_adapter 修复）----\n        .Save -> {\n            storage.set(\"paint.canvas.v1\", .px.join(\"|\"))\n            .saved = \"1\"\n            .status = \"saved\"\n        }\n\n        .Load -> {\n            var snap = storage.get(\"paint.canvas.v1\")\n            if snap != \"\" {\n                var parts = snap.split(\"|\")\n                if parts.len() == 256 {\n                    .PushUndo()\n                    .ApplySnap(snap)\n                    .saved = \"1\"\n                    .status = \"loaded\"\n                } else {\n                    .status = \"bad save data\"\n                }\n            } else {\n                .status = \"no saved canvas\"\n            }\n        }\n    }\n}\n", pac_text: "name: \"pixel-paint\"\nversion: \"1.0.0\"\nscene: \"ui\"\nrender: \"vue\"\nicon: \"pencil\"\ntitle: \"Paint\"\ncategory: \"tool\"\ntheme: \"dark\"\naccent: \"indigo\"\n# Plan 504: 窗口随内容自然尺寸收缩（画布定长 16×16 + 工具/调色板栏）。\nwindow: \"fit\"\n# Plan 552: 桌面策展 opt-in（C 档上架）。\ndesktop: \"true\"\n", loadable: true, search_lc: "paint 031-paint autoui" },
        { id: "041-auto-edit", title: "AutoEdit", category: "04-systems", icon: "app-window", description: "AutoEdit", tags: ["AutoUI"], doc: "# 041-auto-edit — AutoLang 文本编辑器（多文件组件化）\n\n一个\"严肃应用\"轨道的 AutoUI 示例：多 tab 代码编辑器（原生 CodeMirror6 内核），\n带菜单栏/工具栏/全局快捷键三源动作触发、右键菜单、脏 tab 关闭确认、Console\n面板、撤销重做与文件打开/保存。Plans 413/414/418/420/422/428 持续迭代，\nPlan 449 完成组件化重构（单文件 486 行 → 五文件工程）。\n\n## Concepts\n\n- **store 承载全部状态与业务逻辑（038/013 形态）** —— `editor_store.at` 持有\n  tabs/光标/Console/弹层等全部状态；App 的 `on` 薄委托 `store.Xxx()`，事件名\n  与 `auto-edit.at` 的 handler 映射一一对应（Action=声明层，Event=执行层）。\n  重复逻辑收口为两个内部 helper msg：`RemoveAt`（关闭 tab 的 remove+索引修补+\n  激活重算，原先 CloseTab/ConfirmClose 各持一份）、`SyncCursor`（line/col/sel\n  三元组读回，原先 5 处重复）。store handler 间经 `store.Xxx()` 互调（038\n  先例）。派生标量仍由 handler 就地重算——VM view 不能调函数（Plan 402\n  约束），模板只读字段。\n- **013 式组件（无 props + 直调 store）** —— `StatusBar`/`ConsolePanel`/\n  `EditorCtxMenu` 不带 props：标量/锚态经 `use editor_store` 直读 `.store.*`，\n  自有 msg，handler 直调 `store.Xxx()`（013-todo 的 TodoList 形态）。\n- **vm 组件边界（Plan 449 实测定性，重构设计的硬约束）**：\n  1. **回调 props（`on_xxx: msg`）会使组件整体退化为空 fallback**——\n     015-notes 的 NavTree/EditorPanel 在 vm 模式下即如此（015 是 vue 示例）。\n  2. **组件子树对 MCP 快照不可见**（渲染正常、handler 派发正常，但\n     `autoui_snapshot` 只走根模板）——测试矩阵靠快照定位的交互不能进组件。\n  3. **view fn 片段的参数化条件（onclick 实参/条件样式/if 分支）在 vm\n     视图构建中不求值**——片段去重 tab 条不可行（015 的 NoteItem 片段\n     先例只在 vue 模式验证过）。\n  因此 tab 条（x 按钮形状定位、\"+\" 的 `onclick: .ActOpen`）、确认弹层\n  （\"直接关闭\" 文本定位）、code_editor 绑定与空态文本留在 App 根视图。\n- **vm 字节码 bug 规避**：`code_editor_set_text` 编译进 store handler 会产出\n  坏字节码（`virt_memory.rs read_i32` 越界 panic，Plan 449 实测；widget\n  handler 中正常）——该调用留在 App 根 handler（`.ActNew` 内，见 app.at）。\n- **动作三源绑定（Plan 418/423/451）** —— action 注册表 + menubar/toolbar\n  结构以 `widget App` 内的 **`actions {}` 声明块** 表达（Plan 451 起 DSL 化，\n  原项目根的 auto-edit.at 外挂配置退役；外挂文件形态仍兼容——DSL 优先）。\n  vm 渲染器经 `action_config()` 消费：① 键盘回退层（DSL onkeydown 之下）；\n  ② `menubar{}`/`toolbar{}` 占位的配置合成渲染；③ MCP 自动化同源派发。\n  `handler: .ActXxx` 在**解析期校验**命中本 widget 的 `on{}` 事件；\n  `enabled_if`/`checked_if` 为条件表达式字符串，对合并根 state 求值\n  （`.tab_count` 等，无前缀）。热重载：改 app.at 后经 MCP 的\n  `action_config_reload` 工具（或渲染器 mtime 轮询）重读源文件重新提取。\n- **vue 模式限制** —— vue 生成器尚未接入 action 配置：快捷键全部失效、\n  `menubar{}` 生成空壳、`toolbar` 无映射（vue 下只剩 DSL 每控件\n  `onkeydown`）。本示例 pac.at 固定 `render: \"vm\"`。vue 侧支持是独立的\n  编译器特性，另行计划跟踪。\n\n## Source\n\n| 文件 | 职责 |\n|---|---|\n| `src/front/app.at` 的 `actions {}` 块 | 动作注册表（14 个 action）+ menubar/toolbar 结构（Plan 451 DSL 化；原根目录 auto-edit.at 已删除） |\n| `src/front/app.at` | 根 widget `App`（213 行）：actions 声明块 + view 组合 + on 薄委托；测试定位锚交互（tab 条/确认弹层/编辑区/空态）留根 |\n| `src/front/editor_store.at` | `store EditorStore`（342 行）：全部状态 + 业务逻辑 + RemoveAt/SyncCursor 收口 |\n| `src/front/status_bar.at` | `StatusBar` 组件（读 `.store` 标量；`ToggleConsole → store.ActConsole()`） |\n| `src/front/console_panel.at` | `ConsolePanel` 组件（`Clear → store.ConsoleClear()`） |\n| `src/front/ctx_menu.at` | `EditorCtxMenu` 组件（坐标锚态直读 `.store`；`Cut/Copy/SelectAll/Dismiss → store.Ctx*()`） |\n\n## How to Run\n\n```\ncd examples/ui/041-auto-edit\nauto run               # pac.at 默认 render: \"vm\" —— AutoVM + iced 原生窗口\nauto run --render vm   # 同上（显式）\nauto build             # C/ninja 移植路径（windows_ninja port）\n```\n\n需要先构建工具链：`cargo build --features ui-iced --bin auto`（仓库根）。\n\n## Tests\n\n```\ncd examples/ui/041-auto-edit/tests\npython desktop_mcp.py   # MCP 桌面动作矩阵：三源触发/tab 工作区/热重载/OS 键位层\n```\n\n前置：`pip install requests`；可选 `AUTO_BIN` 指向 auto 可执行文件；\n`AUTO_OPEN_PATH`/`AUTO_SAVE_PATH` 环境变量旁路阻塞式文件对话框（不设则跳过\nT9/T10 分组）。\n\n注：Plan 451 起 T10「热重载」走 DSL 源路径（reload 工具或 mtime 轮询重读\napp.at 重新提取 actions + generation bump → 视图重建），实测 50/0 全绿。\nOS 用户键位层（`%APPDATA%/auto/keymaps/auto-edit.at`）保持外部文件——那是\n用户偏好覆盖而非 app 代码；app id 由 pac.at 的 `name`（经 `auto run` 注入\n`AUTO_APP_ID`）提供。\n", source: "// app.at — auto-edit 根组件（Plan 449 组件化重构）。\n//\n// 结构（vm 渲染已验证能力的边界内，见 README「vm 组件边界」）：\n//   editor_store.at   store EditorStore —— 全部状态与业务逻辑（038 形态）\n//   status_bar.at     StatusBar 组件（013 形态：读 .store + 直调 store）\n//   console_panel.at  ConsolePanel 组件（同上）\n//   ctx_menu.at       EditorCtxMenu 组件（右键弹层锚态直读 .store）\n//\n// App 承担：actions 声明（Plan 451：动作注册表 + menubar/toolbar 经 DSL\n// 声明，原 auto-edit.at 外挂配置并入）+ view 组合 + on 薄委托 store.Xxx()\n// （事件名与 actions 的 handler 映射一一对应，Action=声明层，Event=执行层；\n// handler 在解析期校验命中 on{} 事件）。热重载经 action_config_reload\n// 工具或 mtime 轮询重读本文件重新提取。\n// 以下交互必须留在根视图（MCP 矩阵的快照定位锚——vm 下组件子树对快照\n// 不可见，回调 props 更会使组件整体退化，view fn 片段的参数化条件亦不\n// 求值；均为 Plan 449 调查结论，详见 README「vm 组件边界」）：\n//   tab 条（x 按钮形状定位、\"+\" 的 onclick: .ActOpen）、确认弹层\n//   （\"直接关闭\" 文本定位）、编辑区（code_editor 绑定根事件）、空态文本。\n// code_editor_* 内建若编译进 store handler 会产出坏字节码（panic），\n// 故编辑器写操作（set_text）留在根 handler（见 on 块 .ActNew）。\n\nuse editor_store: EditorStore\nuse status_bar: StatusBar\nuse console_panel: ConsolePanel\nuse ctx_menu: EditorCtxMenu\n\nwidget App {\n    // PLAN-618 T-06: tree 四件组件拷贝分发(package use 必须在 widget 内,\n    // 顶层 parse 报 LBrace 错——027 T-03 同款结论)。\n    use { package: official from \"./components\" }\n    // ---- Plan 451: actions 声明块（原 auto-edit.at，DSL 化）----\n    // 三源绑定：shortcut（键盘回退层，DSL onkeydown 之下）、menubar/toolbar\n    // （view 中占位标签的配置合成）、MCP 自动化同源。enabled_if/checked_if\n    // 为条件表达式字符串，对合并根 state 求值（.tab_count 等，无前缀）。\n    // 注意：auto test 的 T10 热重载以 \"actions {\" / \"menubar {\" 行首字符串\n    // 为插入锚——保持这两个标记。\n    actions {\n        action (id: \"file.new\",        handler: .ActNew,        title: \"新建\",   icon: \"file-plus\",   shortcut: \"Ctrl+N\")\n        action (id: \"file.open\",       handler: .ActOpen,       title: \"打开…\",  icon: \"folder-open\", shortcut: \"Ctrl+O\")\n        action (id: \"file.save\",       handler: .ActSave,       title: \"保存\",   icon: \"save\",        shortcut: \"Ctrl+S\",\n                enabled_if: \".store.tab_count > 0\")\n        action (id: \"file.quit\",       handler: .ActQuit,       title: \"退出\",   shortcut: \"Alt+F4\")\n        action (id: \"edit.undo\",       handler: .ActUndo,       title: \"撤销\",   icon: \"undo-2\",      shortcut: \"Ctrl+Z\",\n                checked_if: \".store.edits > 0\")\n        action (id: \"edit.redo\",       handler: .ActRedo,       title: \"重做\",   icon: \"redo-2\",      shortcut: \"Ctrl+Y\")\n        action (id: \"edit.cut\",        handler: .ActCut,        title: \"剪切\",   icon: \"scissors\")\n        action (id: \"edit.copy\",       handler: .ActCopy,       title: \"复制\",   icon: \"copy\")\n        action (id: \"edit.paste\",      handler: .ActPaste,      title: \"粘贴\",   icon: \"clipboard\")\n        action (id: \"edit.select-all\", handler: .ActSelectAll,  title: \"全选\",   shortcut: \"Ctrl+A\")\n        action (id: \"view.console\",    handler: .ActConsole,    title: \"切换 Console\", icon: \"terminal\", shortcut: \"Ctrl+J\",\n                checked_if: \".store.console_open\")\n        // 仅声明层快捷键(验证回退层):Ctrl+D 切换 tab\n        action (id: \"view.switch-tab\", handler: .ActSwitchTab,  title: \"切换 Tab\", shortcut: \"Ctrl+D\")\n        // Plan 428: 代码折叠(切换激活编辑器第 2 行的 fn 块)\n        action (id: \"view.fold\",       handler: .ActFold,       title: \"折叠切换\")\n        action (id: \"help.about\",      handler: .ActAbout,      title: \"关于 auto-edit\")\n\n        menubar {\n            menu (id: \"file\", title: \"文件\") {\n                item (action: \"file.new\")\n                item (action: \"file.open\")\n                item (action: \"file.save\")\n                sep\n                item (action: \"file.quit\")\n            }\n            menu (id: \"edit\", title: \"编辑\") {\n                item (action: \"edit.undo\")\n                item (action: \"edit.redo\")\n                sep\n                item (action: \"edit.cut\")\n                item (action: \"edit.copy\")\n                item (action: \"edit.paste\")\n                item (action: \"edit.select-all\")\n            }\n            menu (id: \"view\", title: \"视图\") {\n                item (action: \"view.console\")\n                item (action: \"view.switch-tab\")\n                item (action: \"view.fold\")\n            }\n            menu (id: \"help\", title: \"帮助\") {\n                item (action: \"help.about\")\n            }\n        }\n\n        toolbar {\n            item (action: \"file.new\")\n            item (action: \"file.open\")\n            item (action: \"file.save\")\n            sep\n            item (action: \"edit.undo\")\n            item (action: \"edit.redo\")\n            sep\n            item (action: \"edit.cut\")\n            item (action: \"edit.copy\")\n            item (action: \"edit.paste\")\n        }\n    }\n\n    view {\n        col (style: \"h-full w-full\") {\n\n            row (style: \"h-8 items-center bg-muted/30 shrink-0 w-full gap-0 px-2\") {\n                menubar {}\n                toolbar (style: \"ml-auto\") {}\n            }\n            // PLAN-618 T-06: 左文件浏览器树 + 右编辑区双列。tab 条/编辑区\n            // 仍留在根视图(Plan 449 vm 组件边界约束指的是组件子树,容器\n            // 嵌套不受限)。\n            row (style: \"flex-1 items-stretch overflow-hidden w-full\") {\n                col (style: \"w-56 shrink-0 border-r border-border bg-card hidden md:flex flex-col gap-2 p-2 overflow-y-auto\") {\n                    text \"EXPLORER\" { style: \"text-[11px] text-zinc-500 px-1 pt-1 tracking-wider\" }\n                    TreeView (nodes: .store.tree_nodes, expanded: .store.tree_expanded, selected: .store.tree_sel, on_toggle: .TreeToggle, on_select: .TreeSelect, directory: true) {}\n                }\n                col (style: \"flex-1 overflow-hidden\") {\n                    row (style: \"h-8 items-center bg-muted/30 shrink-0 w-full gap-0\") {\n                        // 激活/非激活双分支保留原形态：view fn 片段的参数化条件\n                        // （onclick 实参/条件样式/if 分支）在 vm 视图构建中不求值，\n                        // 尚不可用于此（Plan 449 调查结论，见 README）。\n                        for i, t in .store.tabs {\n                            if i == .store.tab {\n                                row (style: \"items-center bg-[#1C1D24]\") {\n                                    button (text: t.title, variant: \"text\") {\n                                        onclick: .TabActivate(i)\n                                        style: \"h-8 px-3 text-[12px] text-zinc-200 font-medium\"\n                                    }\n                                    button (variant: \"text\") {\n                                        icon (name: \"x\", style: \"h-3 w-3 text-zinc-500\") {}\n                                        onclick: .CloseTab(i)\n                                        style: \"h-7 w-6 px-0 py-0 mr-2\"\n                                    }\n                                }\n                            }\n                            if i != .store.tab {\n                                button (text: t.title, variant: \"text\") {\n                                    onclick: .TabActivate(i)\n                                    style: \"h-8 px-3 text-[12px] text-zinc-500\"\n                                }\n                            }\n                        }\n                        button (variant: \"text\") {\n                            icon (name: \"plus\", style: \"h-3.5 w-3.5 text-zinc-400\") {}\n                            onclick: .ActOpen\n                            style: \"h-7 w-7 px-0 py-0 ml-1\"\n                        }\n                    }\n                    col (style: \"h-px w-full bg-border shrink-0\")\n\n                    for i, t in .store.tabs {\n                        if t.key == .store.active_key {\n                            code_editor (key: t.key, lang: \"auto\", style: \"flex-1 w-full\") {\n                                content: t.src\n                                oninput: .SrcChanged(i)\n                                oncursor: .CursorMoved(i)\n                                oncontextmenu: .EditorCtx\n                            }\n                        }\n                    }\n                    if .store.tab_count == 0 {\n                        col (style: \"flex-1 w-full items-center justify-center\") {\n                            text \"没有打开的文件 — 点击 + 或「文件 → 打开」\" {\n                                style: \"text-[13px] text-zinc-500\"\n                            }\n                        }\n                    }\n\n                    if .store.console_open {\n                        ConsolePanel()\n                    }\n                }\n            }\n\n            // Plan 422 P3: 坐标锚弹层 —— 右键编辑器时 EditorCtx(x, y) 记录\n            // 落点并置开；面板本体在 ctx_menu.at 组件。\n            EditorCtxMenu()\n\n            // Plan 420 P2: 关闭脏 tab 的确认弹层(固定落点,坐标锚)。\n            popover (open: .store.confirm_open, x: 420.0, y: 260.0, ondismiss: .ConfirmCancel,\n                     class: \"w-64 bg-[#16171B] border border-zinc-700 shadow-md py-2 px-3\") {\n                text \"有未保存的修改\" { style: \"text-[13px] text-zinc-100 py-1\" }\n                text \"关闭前要保存吗?\" { style: \"text-[12px] text-zinc-400 pb-2\" }\n                row (style: \"gap-2 justify-end\") {\n                    button (text: \"直接关闭\", variant: \"text\") {\n                        onclick: .ConfirmClose\n                        style: \"h-7 px-2 text-[12px] text-zinc-300\"\n                    }\n                    button (text: \"取消\", variant: \"text\") {\n                        onclick: .ConfirmCancel\n                        style: \"h-7 px-2 text-[12px] text-zinc-400\"\n                    }\n                }\n            }\n\n            StatusBar()\n        }\n    }\n\n    on {\n        .TabActivate(i) -> { store.TabActivate(i) }\n        .SrcChanged(i) -> { store.SrcChanged(i) }\n        .CursorMoved(i) -> { store.CursorMoved(i) }\n        .CloseTab(i) -> { store.CloseTab(i) }\n        .ConfirmClose -> { store.ConfirmClose() }\n        .ConfirmCancel -> { store.ConfirmCancel() }\n        .EditorCtx(x, y) -> { store.EditorCtx(x, y) }\n        // code_editor_* 内建若编译进 store handler 会产出坏字节码（panic），\n        // 故编辑器写操作（set_text）留在根 handler；状态操作在 store.ActNew。\n        .ActNew -> {\n            store.ActNew()\n            if .store.tab_count > 0 {\n                code_editor_set_text(.store.active_key, \"\")\n            }\n        }\n        .ActOpen -> { store.ActOpen() }\n        .ActSave -> { store.ActSave() }\n        .ActQuit -> { store.ActQuit() }\n        .ActUndo -> { store.ActUndo() }\n        .ActRedo -> { store.ActRedo() }\n        .ActSelectAll -> { store.ActSelectAll() }\n        .ActCut -> { store.ActCut() }\n        .ActCopy -> { store.ActCopy() }\n        .ActPaste -> { store.ActPaste() }\n        .ActConsole -> { store.ActConsole() }\n        .ActSwitchTab -> { store.ActSwitchTab() }\n        .ActFold -> { store.ActFold() }\n        .ActAbout -> { store.ActAbout() }\n        .TreeToggle(id) -> { store.TreeToggle(id) }\n        .TreeSelect(id) -> { store.TreeSelect(id) }\n    }\n}\n", pac_text: "name: \"auto-edit\"\nversion: \"1.0.0\"\ndescription: \"auto-edit — AutoLang 文本编辑器（Plan 413/414/418，原 041-code-editor）\"\nscene: \"ui\"\nrender: \"vm\"\nfront_port: 4041\ntitle: \"AutoEdit\"\ndesktop: \"true\"\n", loadable: false, search_lc: "autoedit 041-auto-edit autoui" },
        { id: "043-clipboard-bridge", title: "ClipboardBridge", category: "04-systems", icon: "app-window", description: "ClipboardBridge", tags: ["AutoUI"], doc: "# 043-clipboard-bridge — 原生剪贴板三族互通演示(Plan 485)\n\nOS 剪贴板 ↔ 虚拟桌面 App 的 **文本 / 文件 / 图片** 三族双向演示:\n\n| 卡片 | 读取(→App) | 写出(App→OS) | 底层格式 |\n|---|---|---|---|\n| 文本 | `clipboard_text()` | `clipboard_set_text(s)` | arboard(Plan 418) |\n| 文件 | `clipboard_files_get()` | `clipboard_files_set([...])` | Win32 `CF_HDROP` |\n| 图片 | `clipboard_image_get()` | `clipboard_image_set(path)` | Win32 `CF_DIBV5` + registered `\"PNG\"` 双挂 |\n\n## 起跑(示例目录为 CWD)\n\n```bash\ncd examples/ui/043-clipboard-bridge && auto run -r vm\n```\n\n> 在示例目录内起跑(`cd` 后 `auto run -r vm`):资产路径(`assets/…`)与\n> image src 均按进程 CWD(=示例根)解析。\n\n## 实机演示剧本(T4)\n\n1. **文本**:输入框改字 →「写出」→ 去 notepad Ctrl+V 出字;别处 Ctrl+C\n   → 回 App 点「读取」→ 上屏。\n2. **文件**:Explorer 选中 1-2 个文件 Ctrl+C → App 点「读取剪贴板文件」\n   → 路径列表上屏;App 点「写出示例文件」→ 去 Explorer Ctrl+V →\n   `demo.png`/`hello.txt` 粘贴落地。\n3. **图片**:截图工具/浏览器右键复制图片 → App 点「读取剪贴板图片」→\n   缩略图 + 尺寸上屏(临时 PNG 路径);点「写出示例图」→ 画图/浏览器\n   Ctrl+V 出图。\n\n## 降级语义(非 Windows / vue 远程端)\n\n`clipboard_files_get/image_get/image_set` 等内建在非 Windows 或未启用\n`native-clipboard` feature 时**优雅降级**:`files_get → []`、\n`files_set/image_set → false`、`image_get → None`(nil)——.at 代码零平台\n分支。vue/web 远程端无 OS 剪贴板场景,同语义(不做 web polyfill)。\n文本族降级语义见 Plan 418。\n\n## 结构\n\n```\npac.at              # render: \"vm\", front_port 4043\nsrc/front/app.at    # 单 widget:三卡 + 根 handler 调 clipboard_* 内建\nassets/demo.png     # 64×48 RGBA 渐变(写出示例图/文件载荷)\nassets/hello.txt    # 文件族写出载荷\n```\n\n> 内建调用留在根 handler(041 纪律:内建编译进 store handler 会产出坏\n> 字节码)。剪贴板为进程全局资源,演示按钮为显式触发(本期不做全局\n> Ctrl+V 自动路由——Plan 485 非目标)。\n", source: "// app.at — 043-clipboard-bridge 根组件（Plan 485）。\n//\n// OS 剪贴板三族互通演示：\n//   文本（Plan 418 arboard）/ 文件（CF_HDROP）/ 图片（CF_DIBV5 + PNG）。\n// 全部经按钮显式触发（本期不做全局 Ctrl+V 路由，Plan 485 非目标）。\n// clipboard_* 内建与 code_editor_* 同族——统一留在根 handler（041 纪律：\n// 内建编译进 store handler 会产出坏字节码）。\n// 起跑形态为示例目录内 `auto run -r vm`——资产路径（assets/…）与 image\n// src 均按进程 CWD（=示例根）解析。\n\nwidget App {\n    msg Msg {\n        TextGet,\n        TextSet,\n        FilesGet,\n        FilesSet,\n        ImageGet,\n        ImageSet,\n    }\n\n    model {\n        var draft str = \"你好,剪贴板 — Plan 485\"\n        var text_out str = \"(未读取)\"\n        var files list = []\n        var files_read bool = false\n        var img_path str = \"\"\n        var img_w int = 0\n        var img_h int = 0\n        var status str = \"ready — 先在 Explorer/截图工具复制点什么,再点对应卡片按钮\"\n    }\n\n    view {\n        col {\n            style: \"min-h-screen bg-background p-6 gap-4\"\n            col {\n                style: \"gap-1\"\n                h1 \"剪贴板三族互通\" { style: \"text-xl font-bold text-foreground\" }\n                text \"043-clipboard-bridge — text (418) / files (CF_HDROP) / image (DIBV5+PNG)\" {\n                    style: \"text-xs text-muted-foreground\"\n                }\n                text .status { style: \"text-xs text-primary\" }\n            }\n\n            // ── 文本卡 ────────────────────────────────────────────\n            col {\n                style: \"w-full max-w-2xl p-4 bg-card border border-border rounded-xl gap-3\"\n                row {\n                    style: \"items-center gap-2\"\n                    text \"文本\" { style: \"text-sm font-semibold text-foreground\" }\n                    text \"(Plan 418 · arboard)\" { style: \"text-xs text-muted-foreground\" }\n                }\n                row {\n                    style: \"gap-2\"\n                    input {\n                        value: .draft\n                        placeholder: \"要写出到的文本\"\n                        style: \"flex-1 px-2.5 py-2 border border-border rounded-md bg-background text-foreground text-sm\"\n                    }\n                    button {\n                        onclick: .TextSet\n                        style: \"px-3 py-2 rounded-md bg-primary text-primary-foreground text-sm\"\n                        text \"写出\"\n                    }\n                    button {\n                        onclick: .TextGet\n                        style: \"px-3 py-2 rounded-md border border-border text-sm\"\n                        text \"读取\"\n                    }\n                }\n                col {\n                    style: \"gap-1 px-3 py-2 rounded-md bg-muted/40\"\n                    text \"剪贴板文本:\" { style: \"text-xs text-muted-foreground\" }\n                    text .text_out { style: \"text-sm text-foreground\" }\n                }\n            }\n\n            // ── 文件卡 ────────────────────────────────────────────\n            col {\n                style: \"w-full max-w-2xl p-4 bg-card border border-border rounded-xl gap-3\"\n                row {\n                    style: \"items-center gap-2\"\n                    text \"文件\" { style: \"text-sm font-semibold text-foreground\" }\n                    text \"(CF_HDROP · Explorer Ctrl+C / Ctrl+V)\" { style: \"text-xs text-muted-foreground\" }\n                }\n                row {\n                    style: \"gap-2\"\n                    button {\n                        onclick: .FilesGet\n                        style: \"px-3 py-2 rounded-md border border-border text-sm\"\n                        text \"读取剪贴板文件\"\n                    }\n                    button {\n                        onclick: .FilesSet\n                        style: \"px-3 py-2 rounded-md bg-primary text-primary-foreground text-sm\"\n                        text \"写出示例文件\"\n                    }\n                }\n                col {\n                    style: \"gap-1 px-3 py-2 rounded-md bg-muted/40\"\n                    if .files_read {\n                        if .files.len() == 0 {\n                            text \"(剪贴板无 CF_HDROP — 先去 Explorer Ctrl+C 一个文件)\" {\n                                style: \"text-xs text-muted-foreground\"\n                            }\n                        }\n                        for i, p in .files {\n                            text p { style: \"text-sm text-foreground\" }\n                        }\n                    } else {\n                        text \"(未读取)\" { style: \"text-xs text-muted-foreground\" }\n                    }\n                }\n            }\n\n            // ── 图片卡 ────────────────────────────────────────────\n            col {\n                style: \"w-full max-w-2xl p-4 bg-card border border-border rounded-xl gap-3\"\n                row {\n                    style: \"items-center gap-2\"\n                    text \"图片\" { style: \"text-sm font-semibold text-foreground\" }\n                    text \"(CF_DIBV5 / PNG · 截图工具复制后读取)\" { style: \"text-xs text-muted-foreground\" }\n                }\n                row {\n                    style: \"gap-2\"\n                    button {\n                        onclick: .ImageGet\n                        style: \"px-3 py-2 rounded-md border border-border text-sm\"\n                        text \"读取剪贴板图片\"\n                    }\n                    button {\n                        onclick: .ImageSet\n                        style: \"px-3 py-2 rounded-md bg-primary text-primary-foreground text-sm\"\n                        text \"写出示例图\"\n                    }\n                }\n                if .img_path != \"\" {\n                    col {\n                        style: \"gap-1\"\n                        image (src: .img_path) {\n                            style: \"max-w-xs max-h-48 border border-border rounded-md\"\n                        }\n                        text (text: f\"temp: {.img_path}\", style: \"text-xs text-muted-foreground\") {}\n                        text (text: f\"尺寸 {.img_w} × {.img_h}\", style: \"text-xs text-muted-foreground\") {}\n                    }\n                } else {\n                    text \"(未读取 — 截图/浏览器复制图片后点「读取剪贴板图片」)\" {\n                        style: \"text-xs text-muted-foreground\"\n                    }\n                }\n            }\n        }\n    }\n\n    on {\n\n        // ── 文本族（对照 418） ──\n        .TextGet -> {\n            .text_out = clipboard_text()\n            .status = \"text_get → \\\"\" + .text_out + \"\\\"\"\n        }\n        .TextSet -> {\n            let ok = clipboard_set_text(.draft)\n            .status = \"text_set → \" + ok.str()\n        }\n\n        // ── 文件族（CF_HDROP） ──\n        // FilesSet 用 fs.cwd() 拼绝对路径——CF_HDROP 交给 Explorer Ctrl+V\n        // 解析时必须是绝对路径（相对路径 Explorer 无法定位源文件）。\n        .FilesGet -> {\n            let fs = clipboard_files_get()\n            .files = fs\n            .files_read = true\n            .status = \"files_get → \" + .files.len().str() + \" 项(可去 Explorer Ctrl+V 验证)\"\n        }\n        .FilesSet -> {\n            let root = fs.cwd()\n            let ok = clipboard_files_set([root + \"\\assets\\demo.png\", root + \"\\assets\\hello.txt\"])\n            .status = \"files_set → \" + ok.str() + \"(可去 Explorer Ctrl+V 粘贴出两文件)\"\n        }\n\n        // ── 图片族（DIBV5 + PNG） ──\n        .ImageGet -> {\n            let img = clipboard_image_get()\n            if img != nil {\n                .img_path = img.path\n                .img_w = img.width\n                .img_h = img.height\n                .status = \"image_get → \" + img.width.str() + \"×\" + img.height.str()\n            } else {\n                .img_path = \"\"\n                .img_w = 0\n                .img_h = 0\n                .status = \"image_get → none(剪贴板无图像格式)\"\n            }\n        }\n        .ImageSet -> {\n            let ok = clipboard_image_set(\"assets/demo.png\")\n            .status = \"image_set → \" + ok.str() + \"(可去画图/浏览器 Ctrl+V 验证)\"\n        }\n    }\n}\n", pac_text: "name: \"clipboard-bridge\"\nversion: \"1.0.0\"\ndescription: \"clipboard-bridge — 原生剪贴板三族互通演示(text/files/image,Plan 485)\"\nscene: \"ui\"\nrender: \"vm\"\nfront_port: 4043\ntitle: \"ClipboardBridge\"\n", loadable: false, search_lc: "clipboardbridge 043-clipboard-bridge autoui" },
        { id: "044-dnd-bridge", title: "DndBridge", category: "04-systems", icon: "app-window", description: "DndBridge", tags: ["AutoUI"], doc: "# 044-dnd-bridge — 拖放与剪贴板桥接 (Drag & Drop Bridge)\n\n> 原生 VM 下 OLE 拖放双向互通冒烟演示（Plan 488 T6）。\n\n## 功能特性\n\n- **拖出支持**：可向外拖出纯文本、文件路径以及虚拟生成文件。\n- **拖入捕获**：捕获系统外部拖入的文件或内容，提取元数据与二进制流。\n- **剪贴板集成**：与系统剪贴板（Ctrl+V）无缝衔接。\n\n## 运行方式\n\n由于本 Demo 涉及原生操作系统 OLE 拖放事件与系统 API，请在终端以原生 VM 模式运行：\n\n```bash\nauto run -r vm\n```\n", source: "// app.at — 044-dnd-bridge 根组件（Plan 488 T6 冒烟载具）。\n//\n// OLE 拖放双向互通演示：\n//   拖出：三个按钮（文本/真实文件/虚拟文件）→ dnd_start ——注意\n//     dnd_start 在按下线程内联阻塞（OLE 语义），点按钮后拖拽光标即出，\n//     按住左键拖到目标（Explorer/notepad/浏览器）松开即落；Esc 取消。\n//   拖入：从 Explorer/notepad/浏览器拖内容到本 App 的虚拟窗 →\n//     on_native_drop(text/files/image whichever)。\n//   Ctrl+V：桌面级粘贴路由 → on_native_paste（418 文本/485 文件/图片）。\n//   完成效果：on_dnd_finished(copy/move/link/none)。\n// 内建统一留在根 handler（041 纪律）；桌面模式启动：\n//   auto run --desktop -r vm（仓库根执行——apps registry 默认 examples/ui）。\n\nwidget App {\n    msg Msg {\n        DragText,\n        DragFiles,\n        DragVirtual,\n        on_native_drop(record),\n        on_native_paste(record),\n        on_dnd_finished(str),\n    }\n\n    model {\n        var status str = \"ready — 拖出：点按钮后按住左键拖到目标；拖入：从 Explorer/浏览器拖进本窗口\"\n        var drop_log str = \"(尚未收到拖入)\"\n        var drop_fmt str = \"\"\n        var drop_text str = \"\"\n        var drop_files str = \"\"\n        var drop_img str = \"\"\n        var paste_log str = \"(尚未收到 Ctrl+V)\"\n        var paste_text str = \"\"\n        var paste_files str = \"\"\n        var paste_img str = \"\"\n        var finish_log str = \"(尚未发起拖出)\"\n    }\n\n    view {\n        col {\n            style: \"min-h-screen bg-background p-6 gap-4\"\n            col {\n                style: \"gap-1\"\n                h1 \"OLE 拖放双向\" { style: \"text-xl font-bold text-foreground\" }\n                text \"044-dnd-bridge — Plan 488 T6（IDataObject 三格式族 / IDropTarget / Ctrl+V 路由）\" {\n                    style: \"text-xs text-muted-foreground\"\n                }\n                text .status { style: \"text-xs text-primary\" }\n            }\n\n            // ── 拖出卡（A2/A5/A6 源侧） ────────────────────────────\n            col {\n                style: \"w-full max-w-2xl p-4 bg-card border border-border rounded-xl gap-3\"\n                row {\n                    style: \"items-center gap-2\"\n                    text \"拖出\" { style: \"text-sm font-semibold text-foreground\" }\n                    text \"(点按钮 → 按住左键拖到目标 → 松开；Esc 取消)\" {\n                        style: \"text-xs text-muted-foreground\"\n                    }\n                }\n                row {\n                    style: \"flex-wrap gap-2\"\n                    button {\n                        onclick: .DragText\n                        style: \"px-3 py-2 rounded-md bg-primary text-primary-foreground text-sm\"\n                        text \"拖出文本\"\n                    }\n                    button {\n                        onclick: .DragFiles\n                        style: \"px-3 py-2 rounded-md border border-border text-sm\"\n                        text \"拖出真实文件×2\"\n                    }\n                    button {\n                        onclick: .DragVirtual\n                        style: \"px-3 py-2 rounded-md border border-border text-sm\"\n                        text \"拖出虚拟文件(A2)\"\n                    }\n                }\n                text .finish_log { style: \"text-xs text-muted-foreground\" }\n            }\n\n            // ── 拖入卡（A1/A5/A6/D2–D4 目标侧） ────────────────────\n            col {\n                style: \"w-full max-w-2xl p-4 bg-card border border-border rounded-xl gap-2\"\n                row {\n                    style: \"items-center gap-2\"\n                    text \"拖入\" { style: \"text-sm font-semibold text-foreground\" }\n                    text \"(Explorer 文件 / notepad 文本 / 浏览器 URL / Chrome 图片 → 拖到本窗口)\" {\n                        style: \"text-xs text-muted-foreground\"\n                    }\n                }\n                col {\n                    style: \"gap-1 px-3 py-2 rounded-md bg-muted/40\"\n                    text \"on_native_drop:\" { style: \"text-xs text-muted-foreground\" }\n                    text .drop_log { style: \"text-sm text-foreground\" }\n                }\n            }\n\n            // ── Ctrl+V 卡（G3/T7） ─────────────────────────────────\n            col {\n                style: \"w-full max-w-2xl p-4 bg-card border border-border rounded-xl gap-2\"\n                row {\n                    style: \"items-center gap-2\"\n                    text \"桌面级 Ctrl+V\" { style: \"text-sm font-semibold text-foreground\" }\n                    text \"(焦点在本 App 时按 Ctrl+V)\" { style: \"text-xs text-muted-foreground\" }\n                }\n                col {\n                    style: \"gap-1 px-3 py-2 rounded-md bg-muted/40\"\n                    text \"on_native_paste:\" { style: \"text-xs text-muted-foreground\" }\n                    text .paste_log { style: \"text-sm text-foreground\" }\n                }\n            }\n        }\n    }\n\n    on {\n        // ── 拖出（dnd_start 内联阻塞：点按钮时按钮已松开，拖拽等待\n        //    用户按住左键拖动——seen-button 语义，QCD 见到按下前不判释放）──\n        .DragText -> {\n            let ok = dnd_start(\"{\\\"text\\\":\\\"来自 044-dnd-bridge 的拖出文本 — Plan 488 A5\\\"}\")\n            .status = \"拖出文本受理: \" + ok.str() + \"（松开处应出现该文本/URL）\"\n        }\n        .DragFiles -> {\n            // cwd = 桌面宿主启动目录（worktree/仓库根）——资产在示例目录下；\n            // 路径裸反斜杠由 parse 侧宽容修复（escape_bare_backslashes）。\n            let root = fs.cwd()\n            let payload = \"{\\\"files\\\":[\\\"\" + root + \"\\\\examples\\\\ui\\\\044-dnd-bridge\\\\assets\\\\hello.txt\\\",\\\"\" + root + \"\\\\examples\\\\ui\\\\044-dnd-bridge\\\\assets\\\\note.md\\\"]}\"\n            let ok = dnd_start(payload)\n            .status = \"拖出文件受理: \" + ok.str() + \"（Explorer 松开处应落两文件）\"\n        }\n        .DragVirtual -> {\n            let ok = dnd_start(\"{\\\"virtual_files\\\":[{\\\"name\\\":\\\"dnd-bridge-note.md\\\",\\\"content\\\":\\\"# 从桌面拖出的虚拟文件\\\\n双击可开 — Plan 488 用例 A2\\\",\\\"mime\\\":\\\"text/markdown\\\"}]}\")\n            .status = \"虚拟文件受理: \" + ok.str() + \"（Explorer 松开处应落地 md 文件）\"\n        }\n\n        // ── 拖入（宿主注入扁平字段；回避 VM 已知坑：if 内 var 重赋值 +\n        //    .str() 内建会破坏累加——全用直接状态赋值 + join，无 .str()） ──\n        .on_native_drop(p) -> {\n            .drop_fmt = \"[\" + p.formats.join(\",\") + \"]\"\n            .drop_text = \"\"\n            if p.text != \"\" {\n                .drop_text = \" text=\\\"\" + p.text + \"\\\"\"\n            }\n            .drop_files = \"\"\n            if p.files.len() > 0 {\n                .drop_files = \" files=[\" + p.files.join(\";\") + \"]\"\n            }\n            .drop_img = \"\"\n            if p.image_path != \"\" {\n                .drop_img = \" image=\" + p.image_path\n            }\n            .drop_log = .drop_fmt + .drop_text + .drop_files + .drop_img\n            .status = \"on_native_drop ← 已收到拖入\"\n        }\n\n        // ── Ctrl+V（宿主注入扁平字段，同 drop 形状） ──\n        .on_native_paste(p) -> {\n            .paste_text = \"\"\n            if p.text != \"\" {\n                .paste_text = \"text=\\\"\" + p.text + \"\\\"\"\n            }\n            .paste_files = \"\"\n            if p.files.len() > 0 {\n                .paste_files = \" files=[\" + p.files.join(\";\") + \"]\"\n            }\n            .paste_img = \"\"\n            if p.image_path != \"\" {\n                .paste_img = \" image=\" + p.image_path\n            }\n            .paste_log = .paste_text + .paste_files + .paste_img\n            .status = \"on_native_paste ← 已收到 Ctrl+V\"\n        }\n\n        // ── 拖出完成效果 ──\n        .on_dnd_finished(eff) -> {\n            .finish_log = \"on_dnd_finished → \" + eff\n        }\n    }\n}\n", pac_text: "name: \"dnd-bridge\"\nversion: \"1.0.0\"\ndescription: \"dnd-bridge — OLE 拖放双向互通冒烟（拖出 text/files/虚拟文件 + 拖入/Ctrl+V 事件面,Plan 488 T6 载具）\"\nscene: \"ui\"\nrender: \"vm\"\nfront_port: 4044\ntitle: \"DndBridge\"\n", loadable: false, search_lc: "dndbridge 044-dnd-bridge autoui" },
    ]
}

pub fn filter_demos(query str, category str) List {
    var out List = []
    var demos List = all_demos()
    var q str = query.to_lower()
    var i int = 0
    while i < demos.len() {
        var d = demos[i]
        var cat_ok bool = category == "all" || d.category == category
        var q_ok bool = q.len() == 0 || d.search_lc.contains(q)
        if cat_ok && q_ok {
            out.push(d)
        }
        i = i + 1
    }
    return out
}

pub fn demo_title(id str) str {
    return demo_field_str(id, "title", id)
}

pub fn demo_description(id str) str {
    return demo_field_str(id, "description", "")
}

pub fn demo_doc(id str) str {
    return demo_field_str(id, "doc", "")
}

pub fn demo_source(id str) str {
    return demo_field_str(id, "source", "")
}

pub fn demo_pac(id str) str {
    return demo_field_str(id, "pac", "")
}

pub fn demo_loadable(id str) bool {
    var demos List = all_demos()
    var i int = 0
    while i < demos.len() {
        if demos[i].id == id {
            return demos[i].loadable
        }
        i = i + 1
    }
    return false
}

// 缺省回退语义对齐 TS findDemo 桥(demos.ts):未命中时 str 字段回退
// provided 兜底(title 回退 id,其余回退空串)。
pub fn demo_field_str(id str, field str, fallback str) str {
    var demos List = all_demos()
    var i int = 0
    while i < demos.len() {
        if demos[i].id == id {
            if field == "title" {
                return demos[i].title
            }
            if field == "description" {
                return demos[i].description
            }
            if field == "doc" {
                return demos[i].doc
            }
            if field == "source" {
                return demos[i].source
            }
            if field == "pac" {
                return demos[i].pac_text
            }
        }
        i = i + 1
    }
    return fallback
}
