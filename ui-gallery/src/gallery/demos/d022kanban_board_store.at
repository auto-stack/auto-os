// d022kanban_board_store.at — shared BoardStore. Holds the board's cards and re-fetches after
// every mutation (k1 pattern, cf. 018 book_store.at). Pages do `use store: BoardStore`.
use d022kanban_api: all_cards, create_card, delete_card, move_card

store BoardStore {
    model {
        var cards []Card = []
        var loading bool = false
    }

    msg { Init, AddCard(str), RemoveCard(int), MoveCard(int, str) }

    on {
        .Init -> {
            .loading = true
            .cards = d022kanban_api.all_cards()
            .loading = false
        }
        .AddCard(title str) -> {
            d022kanban_api.create_card(title)
            .cards = d022kanban_api.all_cards()
        }
        .RemoveCard(id int) -> {
            d022kanban_api.delete_card(id)
            .cards = d022kanban_api.all_cards()
        }
        .MoveCard(id int, column str) -> {
            d022kanban_api.move_card(id, column)
            .cards = d022kanban_api.all_cards()
        }
    }
}
