// PLAN-658 T-04: gallery back-proxy client (generated, 勿手改)
pub type Contact = {
    id: str
    name: str
    avatar: str
    status: str
    last_message: str
    time: str
    unread: int
}
pub type Message = {
    id: int
    sender: str
    text: str
    time: str
    mine: bool
}
pub tag ChatEvent {
    NewMessage(Message),
    Typing(str),
}

pub fn list_contacts() []Contact {
    return json.to_value(Http.get_json("http://127.0.0.1:3358/apps/017-chat/api/contacts"))
}

pub fn list_messages() []Message {
    return json.to_value(Http.get_json("http://127.0.0.1:3358/apps/017-chat/api/messages"))
}

pub fn send_message(sender str, text str) Message {
    return json.to_value(Http.post_json("http://127.0.0.1:3358/apps/017-chat/api/messages", "{" + "\"sender\":" + json.from_value(sender) + "," + "\"text\":" + json.from_value(text) + "}"))
}

pub fn bot_reply(contact_id str, query str) Message {
    return json.to_value(Http.post_json("http://127.0.0.1:3358/apps/017-chat/api/bot_reply", "{" + "\"contact_id\":" + json.from_value(contact_id) + "," + "\"query\":" + json.from_value(query) + "}"))
}

pub fn set_typing(sender str) {
    Http.post_json("http://127.0.0.1:3358/apps/017-chat/api/typing", "{" + "\"sender\":" + json.from_value(sender) + "}")
    return
}
