// components/tree_util.at — tree 组件族纯函数工具(PLAN-614)。
//
// flatten_tree: 嵌套树 × 展开态 → 可见行序列。显式栈迭代 DFS(无递归——
// chart/diagram 族同款纪律),row 记录携带渲染所需一切(缩进/图标/chevron/
// 状态 class 字面量),组件 view 零逻辑。受控契约:expanded/selected 由
// 页面持有,本模块只做纯派生,双端(vue 转译进 SFC / VM import_aliases)
// 同源(Plan 522 路径,calendar_util 先例)。
//
// ⚠ VM 轨遍历纪律(P614 实证):for-in 对函数参数列表迭代零次(对状态
// 路径迭代正常)——本模块所有列表遍历一律 while + 索引(索引访问参数
// 列表已实证正常)。嵌套 children 同式。
//
// kind: "dir"|"file"|"" 仅 directory 模式消费；显式 icon 优先于自动映射。
pub type TreeNode {
    id str
    label str
    kind str
    icon str
    is_leaf bool
    badge str
    children List<TreeNode>
}

type TreeRow {
    id str
    label str
    depth int
    has_kids bool
    open bool
    leaf bool
    icon str
    badge str
    guides List<str>
    chev str
    state str
}

/// 线性成员测试(while+索引;for-in 参数列表 VM 零次迭代,见头注)。
pub fn has_id(list List<str>, id str) bool {
    var found bool = false
    var i int = 0
    while i < list.len() {
        if list[i] == id {
            found = true
        }
        i = i + 1
    }
    return found
}

/// 切换 id 在列表中的成员资格(返回新 List,不动输入——受控更新函数式)。
pub fn toggle_id(list List<str>, id str) List<str> {
    var out List<str> = []
    var found bool = false
    var i int = 0
    while i < list.len() {
        if list[i] == id {
            found = true
        } else {
            out.push(list[i])
        }
        i = i + 1
    }
    if !found {
        out.push(id)
    }
    return out
}

/// 全部(或仅目录)id 收集——Expand All / Collapse All 用。
pub fn collect_ids(nodes List<TreeNode>, dirs_only bool) List<str> {
    var out List<str> = []
    var parents List<List<TreeNode>> = []
    var positions List<int> = []
    var current = nodes
    var i int = 0
    while i < current.len() || parents.len() > 0 {
        if i == current.len() {
            let parent = parents.remove(parents.len() - 1)
            current = parent.move
            i = positions.remove(positions.len() - 1)
        } else {
            let kids = current[i].children
            if !dirs_only || current[i].kind == "dir" || kids.len() > 0 {
                out.push(current[i].id.clone())
            }
            i = i + 1
            if kids.len() > 0 {
                // 只有还有兄弟节点待访问时才保留当前层。
                if i < current.len() {
                    parents.push(current.move)
                    positions.push(i)
                }
                current = kids.move
                i = 0
            }
        }
    }
    return out
}

/// 文件名 → 文件图标(lucide 名)。图片族/文本族/其余 file。
pub fn ext_icon(name str) Str {
    var ic Str = "file"
    if name.ends_with(".png") || name.ends_with(".jpg") || name.ends_with(".jpeg") || name.ends_with(".gif") || name.ends_with(".webp") || name.ends_with(".svg") {
        ic = "image"
    } else {
        if name.ends_with(".at") || name.ends_with(".rs") || name.ends_with(".ts") || name.ends_with(".vue") || name.ends_with(".md") || name.ends_with(".txt") || name.ends_with(".json") || name.ends_with(".toml") || name.ends_with(".css") || name.ends_with(".js") {
            ic = "file-text"
        }
    }
    return ic
}

/// 嵌套树 → 可见行序列(跳过未展开子树)。
/// row = { id, label, depth, has_kids, open, leaf, icon, badge, guides, chev, state }。
/// guides = 每层缩进单元的线型列表("l"=连续竖线,"n"=断线——父为末子时
/// 该层线在下行断开,└ 语义;长度 = depth)。缩进由 guides 单元(w-4)承载,
/// 不再用 pl-N。
pub fn flatten_tree(nodes List<TreeNode>, expanded List<str>, directory bool, selected str) List<TreeRow> {
    var rows List<TreeRow> = []
    var parents List<List<TreeNode>> = []
    var positions List<int> = []
    var pathGuides List<str> = []
    var current = nodes
    var i int = 0
    while i < current.len() || parents.len() > 0 {
        if i == current.len() {
            let parent = parents.remove(parents.len() - 1)
            current = parent.move
            i = positions.remove(positions.len() - 1)
            pathGuides.remove(pathGuides.len() - 1)
        } else {
            let kids = current[i].children
            let id = current[i].id.clone()
            let label = current[i].label.clone()
            let has_kids = kids.len() > 0 && !current[i].is_leaf
            let open = has_kids && has_id(expanded, id)
            var icon Str = current[i].icon.clone()
            if icon == "" && directory {
                if current[i].kind == "dir" || has_kids {
                    if open {
                        icon = "folder-open"
                    } else {
                        icon = "folder"
                    }
                } else {
                    icon = ext_icon(label)
                }
            }
            var chev str = "chevron-right"
            if open {
                chev = "chevron-down"
            }
            var state str = "hover:bg-accent/50"
            if selected != "" && selected == id {
                state = "bg-accent text-accent-foreground"
            }
            let depth = pathGuides.len()
            var guides List<str> = []
            var j int = 0
            while j < depth {
                guides.push(pathGuides[j].clone())
                j = j + 1
            }
            rows.push(TreeRow {
                id: id.move, label: label.move, depth: depth, has_kids: has_kids,
                open: open, leaf: !has_kids, icon: icon.move, badge: current[i].badge.clone(),
                guides: guides.move, chev: chev.clone(), state: state.clone()
            })
            if open {
                if depth > 0 && i == 0 {
                    pathGuides.push("n")
                } else {
                    pathGuides.push("l")
                }
                parents.push(current.move)
                positions.push(i + 1)
                current = kids.move
                i = 0
            } else {
                i = i + 1
            }
        }
    }
    return rows
}

/// 保留标签命中及祖先，保留各级原顺序。
pub fn filter_tree(nodes List<TreeNode>, kw str) List<TreeNode> {
    var out List<TreeNode> = []
    var i int = 0
    while i < nodes.len() {
        let kids = nodes[i].children
        var filtered List<TreeNode> = []
        if kids.len() > 0 {
            filtered = filter_tree(kids, kw)
        }
        let label = nodes[i].label.clone()
        if kw == "" || label.contains(kw) || filtered.len() > 0 {
            out.push(TreeNode {
                id: nodes[i].id.clone(), label: label.move, kind: nodes[i].kind.clone(),
                icon: nodes[i].icon.clone(), is_leaf: nodes[i].is_leaf, badge: nodes[i].badge.clone(),
                children: filtered.move
            })
        }
        i = i + 1
    }
    return out
}
