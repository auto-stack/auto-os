// pages/menubar.at - Menubar component documentation page
// PLAN-695 T-10: 裸壳 `menubar {}` 重写为 shadcn-vue 官方 demo 等价的
// 完整示例——四菜单（File/Edit/View/Profiles）覆盖全族 kind：shortcut
// （item prop + 独立子件）、disabled、Share/Find 两个 submenu、View 菜单
// checkbox-item（受控绑定 .show_urls）、Profiles radio-group（绑定
// .profile）、separator、label。状态回显行走 store 绑定（双臂同源）。

widget MenubarPage {
    model {
        activeTab str = "preview"
        // View 菜单 checkbox 受控态（PLAN-630 家族 checked 单向绑定 +
        // onclick 回写）。
        var show_urls bool = false
        // Profiles 菜单 radio-group 绑定值。
        var profile str = "ada"
    }

    on {
        .ToggleFullUrls -> { .show_urls = !.show_urls }
        .ProfileAda -> { .profile = "ada" }
        .ProfileTuring -> { .profile = "turing" }
        .ProfileHopper -> { .profile = "hopper" }
        .ShareMail -> { toast("Share via Email clicked") }
        .ShareTwitter -> { toast("Share via Twitter clicked") }
        .FindSearch -> { toast("Find: Search…") }
        .FindCut -> { toast("Find: Cut") }
        .FileNew -> { toast("File: New Tab") }
        .FilePrint -> { toast("File: Print…") }
        .EditUndo -> { toast("Edit: Undo") }
        .EditRedo -> { toast("Edit: Redo") }
    }

    view {
        col {
            h1 "Menubar"
            text "Menubar is a horizontal menu bar with dropdown menus, mimicking the classic desktop application menu (File, Edit, View, Profiles). Each menu contains a trigger button and a dropdown with items, separators, checkbox and radio items, group labels, standalone shortcuts, and nested submenus. Menus follow shadcn semantics: hover switches between open menus, disabled items render greyed out, and panel colors follow the popover theme tokens in both light and dark modes."

            h2 "Installation"
            codeblock (lang: "bash", code: "npx shadcn-vue@latest add menubar") {}

            h2 "Menus"
            preview-card (id: "menubar-family", auto: "widget Demo {\n    model {\n        var show_urls bool = false\n        var profile str = \"ada\"\n    }\n    on {\n        .ToggleFullUrls -> { .show_urls = !.show_urls }\n        .ProfileAda -> { .profile = \"ada\" }\n        .ProfileTuring -> { .profile = \"turing\" }\n        .ProfileHopper -> { .profile = \"hopper\" }\n        .ShareMail -> { toast(\"Share via Email clicked\") }\n        .ShareTwitter -> { toast(\"Share via Twitter clicked\") }\n        .FindSearch -> { toast(\"Find: Search…\") }\n        .FindCut -> { toast(\"Find: Cut\") }\n        .FileNew -> { toast(\"File: New Tab\") }\n        .FilePrint -> { toast(\"File: Print…\") }\n        .EditUndo -> { toast(\"Edit: Undo\") }\n        .EditRedo -> { toast(\"Edit: Redo\") }\n    }\n    view {\n        menubar {\n            menubar-menu (value: \"file\") {\n                menubar-trigger \"File\"\n                menubar-content {\n                    menubar-item (title: \"New Tab\", shortcut: \"⌘T\") { onclick: .FileNew }\n                    menubar-item (title: \"New Window\", shortcut: \"⌘N\") {}\n                    menubar-item (title: \"New Incognito Window\", shortcut: \"⇧⌘N\", disabled: true)\n                    menubar-separator\n                    menubar-sub {\n                        menubar-sub-trigger (text: \"Share\")\n                        menubar-sub-content {\n                            menubar-item (title: \"Email Link\") { onclick: .ShareMail }\n                            menubar-item (title: \"Twitter\") { onclick: .ShareTwitter }\n                        }\n                    }\n                    menubar-separator\n                    menubar-item (title: \"Print…\", shortcut: \"⌘P\") { onclick: .FilePrint }\n                }\n            }\n            menubar-menu (value: \"edit\") {\n                menubar-trigger \"Edit\"\n                menubar-content {\n                    menubar-item (title: \"Undo\", shortcut: \"⌘Z\") { onclick: .EditUndo }\n                    menubar-item (title: \"Redo\", shortcut: \"⇧⌘Z\") { onclick: .EditRedo }\n                    menubar-separator\n                    menubar-sub {\n                        menubar-sub-trigger (text: \"Find\")\n                        menubar-sub-content {\n                            menubar-item (title: \"Search…\", shortcut: \"⌘F\") { onclick: .FindSearch }\n                            menubar-item (title: \"Cut\", shortcut: \"⌘X\") { onclick: .FindCut }\n                        }\n                    }\n                }\n            }\n            menubar-menu (value: \"view\") {\n                menubar-trigger \"View\"\n                menubar-content {\n                    menubar-checkbox-item (title: \"Always Show Full URLs\", checked: .show_urls) { onclick: .ToggleFullUrls }\n                    menubar-separator\n                    menubar-label (text: \"Zoom\")\n                    menubar-item (title: \"Zoom In\", shortcut: \"⌘+\") {}\n                    menubar-item (title: \"Zoom Out\", shortcut: \"⌘−\") {}\n                    menubar-item (title: \"Actual Size\", shortcut: \"⌘0\", enabled: false)\n                }\n            }\n            menubar-menu (value: \"profiles\") {\n                menubar-trigger \"Profiles\"\n                menubar-content {\n                    menubar-radio-group (value: .profile) {\n                        menubar-radio-item (value: \"ada\", title: \"Ada Lovelace\") { onclick: .ProfileAda }\n                        menubar-radio-item (value: \"turing\", title: \"Alan Turing\") { onclick: .ProfileTuring }\n                        menubar-radio-item (value: \"hopper\", title: \"Grace Hopper\", disabled: true)\n                    }\n                    menubar-separator\n                    menubar-shortcut \"⌘E\"\n                }\n            }\n        }\n    }\n}") {
                menubar {
                    menubar-menu (value: "file") {
                        menubar-trigger "File"
                        menubar-content {
                            menubar-item (title: "New Tab", shortcut: "⌘T") { onclick: .FileNew }
                            menubar-item (title: "New Window", shortcut: "⌘N") {}
                            menubar-item (title: "New Incognito Window", shortcut: "⇧⌘N", disabled: true)
                            menubar-separator
                            menubar-sub {
                                menubar-sub-trigger (text: "Share")
                                menubar-sub-content {
                                    menubar-item (title: "Email Link") { onclick: .ShareMail }
                                    menubar-item (title: "Twitter") { onclick: .ShareTwitter }
                                }
                            }
                            menubar-separator
                            menubar-item (title: "Print…", shortcut: "⌘P") { onclick: .FilePrint }
                        }
                    }
                    menubar-menu (value: "edit") {
                        menubar-trigger "Edit"
                        menubar-content {
                            menubar-item (title: "Undo", shortcut: "⌘Z") { onclick: .EditUndo }
                            menubar-item (title: "Redo", shortcut: "⇧⌘Z") { onclick: .EditRedo }
                            menubar-separator
                            menubar-sub {
                                menubar-sub-trigger (text: "Find")
                                menubar-sub-content {
                                    menubar-item (title: "Search…", shortcut: "⌘F") { onclick: .FindSearch }
                                    menubar-item (title: "Cut", shortcut: "⌘X") { onclick: .FindCut }
                                }
                            }
                        }
                    }
                    menubar-menu (value: "view") {
                        menubar-trigger "View"
                        menubar-content {
                            menubar-checkbox-item (title: "Always Show Full URLs", checked: .show_urls) { onclick: .ToggleFullUrls }
                            menubar-separator
                            menubar-label (text: "Zoom")
                            menubar-item (title: "Zoom In", shortcut: "⌘+") {}
                            menubar-item (title: "Zoom Out", shortcut: "⌘−") {}
                            menubar-item (title: "Actual Size", shortcut: "⌘0", enabled: false)
                        }
                    }
                    menubar-menu (value: "profiles") {
                        menubar-trigger "Profiles"
                        menubar-content {
                            menubar-radio-group (value: .profile) {
                                menubar-radio-item (value: "ada", title: "Ada Lovelace") { onclick: .ProfileAda }
                                menubar-radio-item (value: "turing", title: "Alan Turing") { onclick: .ProfileTuring }
                                menubar-radio-item (value: "hopper", title: "Grace Hopper", disabled: true)
                            }
                            menubar-separator
                            menubar-shortcut "⌘E"
                        }
                    }
                }
            }

            h2 "Bound State"
            text "Checkbox and radio selections write back to the page store — the echo line below reflects the live state on both backends."
            preview-card (id: "menubar-bound-echo") {
                col (style: "gap-2 w-full") {
                    menubar {
                        menubar-menu (value: "view") {
                            menubar-trigger "View"
                            menubar-content {
                                menubar-checkbox-item (title: "Always Show Full URLs", checked: .show_urls) { onclick: .ToggleFullUrls }
                            }
                        }
                        menubar-menu (value: "profiles") {
                            menubar-trigger "Profiles"
                            menubar-content {
                                menubar-radio-group (value: .profile) {
                                    menubar-radio-item (value: "ada", title: "Ada Lovelace") { onclick: .ProfileAda }
                                    menubar-radio-item (value: "turing", title: "Alan Turing") { onclick: .ProfileTuring }
                                }
                            }
                        }
                    }
                    text f"show_urls = ${.show_urls} · profile = ${.profile}" { style: "text-sm text-muted-foreground" }
                }
            }

            h2 "Properties"
            table {
                thead {
                    tr {
                        th "Property"
                        th "Type"
                        th "Default"
                        th "Values"
                        th "Description"
                    }
                }
                tbody {
                    tr {
                        td "menubar / class"
                        td "string"
                        td "-"
                        td "-"
                        td "Bar container CSS classes"
                    }
                    tr {
                        td "menubar-menu / value"
                        td "string"
                        td "auto"
                        td "-"
                        td "Menu identity (open-state key)"
                    }
                    tr {
                        td "menubar-trigger / text"
                        td "string"
                        td "-"
                        td "-"
                        td "Trigger label (positional text accepted)"
                    }
                    tr {
                        td "menubar-content / align"
                        td "one_of"
                        td "start"
                        td "start, center, end"
                        td "Panel alignment (Vue track)"
                    }
                    tr {
                        td "menubar-item / title"
                        td "string | state_ref"
                        td "-"
                        td "-"
                        td "Item label"
                    }
                    tr {
                        td "menubar-item / icon"
                        td "string | state_ref"
                        td "-"
                        td "lucide kebab"
                        td "Leading icon"
                    }
                    tr {
                        td "menubar-item / shortcut"
                        td "string | state_ref"
                        td "-"
                        td "-"
                        td "Right-aligned hint (MenubarShortcut)"
                    }
                    tr {
                        td "menubar-item / enabled"
                        td "bool | state_ref"
                        td "true"
                        td "-"
                        td "Enabled state (greyed when false)"
                    }
                    tr {
                        td "menubar-item / disabled"
                        td "boolean"
                        td "false"
                        td "true, false"
                        td "Static disabled (greyed, not hidden)"
                    }
                    tr {
                        td "menubar-item / onclick"
                        td "msg_ref"
                        td "-"
                        td "-"
                        td "Click handler"
                    }
                    tr {
                        td "menubar-checkbox-item / checked"
                        td "bool | state_ref"
                        td "false"
                        td "-"
                        td "One-way checkmark binding + onclick write-back"
                    }
                    tr {
                        td "menubar-radio-group / value"
                        td "string | state_ref"
                        td "-"
                        td "-"
                        td "Selected radio value binding"
                    }
                    tr {
                        td "menubar-radio-item / value"
                        td "string"
                        td "-"
                        td "-"
                        td "Option identity (matched against group value)"
                    }
                    tr {
                        td "menubar-label / text"
                        td "string"
                        td "-"
                        td "-"
                        td "Group heading (muted, non-interactive)"
                    }
                    tr {
                        td "menubar-shortcut"
                        td "text child"
                        td "-"
                        td "-"
                        td "Standalone right-aligned hint"
                    }
                    tr {
                        td "menubar-sub-trigger / text"
                        td "string"
                        td "-"
                        td "-"
                        td "Submenu trigger label (chevron auto-appended)"
                    }
                    tr {
                        td "menubar-sub-content"
                        td "container"
                        td "-"
                        td "-"
                        td "Nested panel (right-aligned top popover on VM)"
                    }
                    tr {
                        td "menubar-group"
                        td "container"
                        td "-"
                        td "-"
                        td "Semantic item grouping"
                    }
                    tr {
                        td "menubar-separator"
                        td "leaf"
                        td "-"
                        td "-"
                        td "Horizontal hairline"
                    }
                }
            }
        }
    }
}
