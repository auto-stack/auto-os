// pages/pagination.at - Pagination component documentation page

widget PaginationPage {
    model { activeTab str = "preview" }

    view {
        col {
            h1 "Pagination"
            text "Pagination splits content across multiple pages, letting users navigate with previous/next buttons and page number links. Essential for tables, search results, and any list too long to display at once. Supports first/last buttons, ellipsis for large ranges, and active page highlighting."

            h2 "Installation"
            codeblock (lang: "bash", code: "npx shadcn-vue@latest add pagination") {}

            h2 "Simple"
            preview-card (id: "pagination-basic") {
                row (style: "gap-2 items-center") {
                    pagination (total: 100, per_page: 10) {
                        pagination-list {
                            pagination-previous {}
                            pagination-item (value: 1) { text "1" {} }
                            pagination-item (value: 2) { text "2" {} }
                            pagination-ellipsis {}
                            pagination-item (value: 10) { text "10" {} }
                            pagination-next {}
                        }
                    }
                }
            }

            h2 "Properties"
            table {
                thead {
                    tr {
                        th "Property"
                        th "Type"
                        th "Default"
                        th "Values"
                        th "Description"
                    }
                }
                tbody {
                    tr {
                        td "total"
                        td "number"
                        td "-"
                        td "-"
                        td "Total number of pages"
                    }
                    tr {
                        td "page"
                        td "number"
                        td "1"
                        td "-"
                        td "Current page number"
                    }
                    tr {
                        td "sibling-count"
                        td "number"
                        td "-"
                        td "-"
                        td "Number of visible page buttons"
                    }
                }
            }
        }
    }
}
