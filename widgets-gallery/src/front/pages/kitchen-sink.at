            h2 "nav-item"
            row (style: "gap-2 flex-wrap items-center") {
                nav-item {}
                nav-item (to: "sample") {}
                nav-item (exact: true) {}
                nav-item (icon: "sample") {}
                nav-item (label: "sample") {}
            }

            h2 "p"
            row (style: "gap-2 flex-wrap items-center") {
                p "sample" {}
            }

            h2 "popover"
            row (style: "gap-2 flex-wrap items-center") {
                popover {}
                popover (placement: "bottom") {}
                popover (placement: "bottom-start") {}
            }

            h2 "progress"
            row (style: "gap-2 flex-wrap items-center") {
                progress {}
                progress (value: 1) {}
                progress (max: 1) {}
            }

            h2 "row"
            row (style: "gap-2 flex-wrap items-center") {
                row {}
                row (gap: 1) {}
                row (align: "start") {}
                row (align: "center") {}
            }

            h2 "scroll"
            row (style: "gap-2 flex-wrap items-center") {
                scroll {}
                scroll (direction: "vertical") {}
                scroll (direction: "horizontal") {}
            }

            h2 "select"
            row (style: "gap-2 flex-wrap items-center") {
                select {}
                select (placeholder: "sample") {}
                select (disabled: "true") {}
                select (disabled: "false") {}
            }

            h2 "separator"
            row (style: "gap-2 flex-wrap items-center") {
                separator {}
                separator (orientation: "horizontal") {}
                separator (orientation: "vertical") {}
                separator (label: "sample") {}
            }

            h2 "sheet_content"
            row (style: "gap-2 flex-wrap items-center") {
                sheet_content {}
                sheet_content (side: "top") {}
                sheet_content (side: "right") {}
            }

            h2 "sheet_title"
            row (style: "gap-2 flex-wrap items-center") {
                sheet_title "sample" {}
            }

            h2 "sheet_trigger"
            row (style: "gap-2 flex-wrap items-center") {
                sheet_trigger {}
                sheet_trigger (as_child: true) {}
            }

            h2 "sidebar"
            row (style: "gap-2 flex-wrap items-center") {
                sidebar {}
                sidebar (side: "left") {}
                sidebar (side: "right") {}
                sidebar (variant: "sidebar") {}
                sidebar (variant: "floating") {}
            }

            h2 "sidebar_menu_button"
            row (style: "gap-2 flex-wrap items-center") {
                sidebar_menu_button "sample" {}
                sidebar_menu_button (tooltip: "sample") {}
                sidebar_menu_button (active: true) {}
            }

            h2 "slot"
            row (style: "gap-2 flex-wrap items-center") {
                slot {}
                slot (name: "sample") {}
            }

            h2 "spacer"
            row (style: "gap-2 flex-wrap items-center") {
                spacer {}
                spacer (size: 1) {}
            }

            h2 "span"
            row (style: "gap-2 flex-wrap items-center") {
                span "sample" {}
            }

            h2 "text"
            row (style: "gap-2 flex-wrap items-center") {
                text {}
                text (selectable: true) {}
            }

            h2 "textarea"
            row (style: "gap-2 flex-wrap items-center") {
                textarea {}
                textarea (placeholder: "sample") {}
                textarea (disabled: true) {}
                textarea (rows: 1) {}
            }

            h2 "toaster"
            row (style: "gap-2 flex-wrap items-center") {
                toaster {}
                toaster (position: "top-left") {}
