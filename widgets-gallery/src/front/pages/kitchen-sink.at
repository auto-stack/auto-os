                label "sample" {}
                label (for: "sample") {}
                label (selectable: true) {}
            }

            h2 "link"
            row (style: "gap-2 flex-wrap items-center") {
                link (text: "sample", href: "sample") {}
                link (href: "sample") {}
            }

            h2 "mouse-area"
            row (style: "gap-2 flex-wrap items-center") {
                mouse-area {}
                mouse-area (coords: "sample") {}
            }

            h2 "native_button"
            row (style: "gap-2 flex-wrap items-center") {
                native_button "sample" {}
                native_button (disabled: true) {}
