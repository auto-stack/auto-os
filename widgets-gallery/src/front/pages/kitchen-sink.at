                hover_card_content (side: "top") {}
                hover_card_content (side: "right") {}
            }

            h2 "hover_card_trigger"
            row (style: "gap-2 flex-wrap items-center") {
                hover_card_trigger {}
                hover_card_trigger (as_child: true) {}
            }

            h2 "icon"
            row (style: "gap-2 flex-wrap items-center") {
                icon {}
                icon (name: "sample") {}
                icon (size: 1) {}
            }

            h2 "image"
            row (style: "gap-2 flex-wrap items-center") {
                image {}
                image (src: "/icon.png") {}
