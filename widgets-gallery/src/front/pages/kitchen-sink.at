            row (style: "gap-2 flex-wrap items-center") {
                drawer_description "sample" {}
            }

            h2 "drawer_title"
            row (style: "gap-2 flex-wrap items-center") {
                drawer_title "sample" {}
            }

            h2 "drawer_trigger"
            row (style: "gap-2 flex-wrap items-center") {
                drawer_trigger {}
                drawer_trigger (as_child: true) {}
            }

            h2 "dropdown-menu"
            row (style: "gap-2 flex-wrap items-center") {
                dropdown-menu "sample" {}
                dropdown-menu (disabled: "true") {}
                dropdown-menu (disabled: "false") {}
                dropdown-menu (shortcut: "sample") {}
            }

            h2 "grid"
            row (style: "gap-2 flex-wrap items-center") {
                grid {}
                grid (columns: 1) {}
                grid (gap: 1) {}
            }

            h2 "hover_card"
            row (style: "gap-2 flex-wrap items-center") {
