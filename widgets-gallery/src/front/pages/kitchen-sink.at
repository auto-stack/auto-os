// Plan 435 P5b —— kitchen-sink demo 页(schema/aura.at 生成,**勿手改**)
// 再生成:auto docs gen(测试内等价 KITCHEN_SINK_UPDATE=1 cargo test -p auto-lang --test docs_gen)
// 覆盖:builtin_widget 层含可字面化 props 的全部元素(当前 50 个)。

widget KitchenSinkPage {
    msg { Go }
    model { dummy int = 0 }
    on { .Go -> { } }
    view {
        col (style: "p-6 space-y-8") {
            h1 "Kitchen Sink"
            text "核心组件全量示例 —— schema 生成页,展示每个组件的 props 取值。" { style: "text-muted-foreground" }

            h2 "alert_dialog_action"
            row (style: "gap-2 flex-wrap items-center") {
                alert_dialog_action "sample" {}
            }

            h2 "alert_dialog_cancel"
            row (style: "gap-2 flex-wrap items-center") {
                alert_dialog_cancel "sample" {}
            }

            h2 "alert_dialog_description"
            row (style: "gap-2 flex-wrap items-center") {
                alert_dialog_description "sample" {}
            }

            h2 "alert_dialog_title"
            row (style: "gap-2 flex-wrap items-center") {
                alert_dialog_title "sample" {}
            }

            h2 "alert_dialog_trigger"
            row (style: "gap-2 flex-wrap items-center") {
                alert_dialog_trigger {}
                alert_dialog_trigger (as_child: true) {}
            }

            h2 "autodown_editor"
            row (style: "gap-2 flex-wrap items-center") {
                autodown_editor {}
            }

            h2 "avatar"
            row (style: "gap-2 flex-wrap items-center") {
                avatar {}
                avatar (src: "/icon.png") {}
                avatar (alt: "sample") {}
                avatar (fallback: "sample") {}
            }

            h2 "badge"
            row (style: "gap-2 flex-wrap items-center") {
                badge "sample" {}
                badge (variant: "default") {}
                badge (variant: "secondary") {}
            }

            h2 "button"
            row (style: "gap-2 flex-wrap items-center") {
                button "sample" {}
                button (variant: "default") {}
                button (variant: "secondary") {}
                button (size: "sm") {}
                button (size: "default") {}
            }

            h2 "code_editor"
            row (style: "gap-2 flex-wrap items-center") {
                code_editor {}
            }

            h2 "col"
            row (style: "gap-2 flex-wrap items-center") {
                col {}
                col (gap: 1) {}
                col (align: "start") {}
                col (align: "center") {}
            }

            h2 "container"
            row (style: "gap-2 flex-wrap items-center") {
                container {}
                container (max_width: 1) {}
            }

            h2 "divider"
            row (style: "gap-2 flex-wrap items-center") {
                divider {}
                divider (direction: "horizontal") {}
                divider (direction: "vertical") {}
            }

            h2 "drawer"
            row (style: "gap-2 flex-wrap items-center") {
                drawer {}
                drawer (direction: "left") {}
                drawer (direction: "right") {}
            }

