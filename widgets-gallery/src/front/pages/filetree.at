        ]
    }

    view {
        col {
            h1 "FileTree"
            text "FileTree is a file-system flavored preset of TreeView: directory nodes show folder / folder-open icons by expanded state, files get extension icons, and the expand / selection state is managed internally — no controlled wiring needed. Node ids follow path semantics (\"docs/plans/archive\"), matching a filesystem walk. The badge field renders right-aligned meta text — file sizes here."

            h2 "Installation"
            codeblock (lang: "bash", code: "use { package: official from \"./components\" }") {}

            h2 "Demo"
            text "This demo mirrors a real repository layout — every plan document under docs/plans (7 active + 604 archived). default_expanded seeds the initially expanded directories; chevrons and folder icons toggle the internal state." (style: "text-muted-foreground") {}
            preview-card (id: "filetree-demo") {
                FileTree (nodes: .ftNodes, default_expanded: ["docs", "docs/plans"]) {}
            }

            h2 "Properties"
            table {
                thead {
                    tr {
                        th "Property"
                        th "Type"
                        th "Default"
                        th "Values"
                        th "Description"
                    }
                }
                tbody {
                    tr {
                        td "nodes"
                        td "List"
                        td "[]"
                        td "node records"
                        td "File tree data: { id, label, kind: \"dir\" | \"file\", children, badge }"
                    }
                    tr {
                        td "default_expanded"
                        td "List"
                        td "[]"
                        td "id strings"
                        td "Directories expanded on mount"
                    }
                }
            }
        }
    }
}

